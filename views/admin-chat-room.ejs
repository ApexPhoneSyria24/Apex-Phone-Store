<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"><title>محادثة مع <%= visitorId %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 font-sans h-screen flex flex-col">
  <div class="bg-slate-900 text-white p-4 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center font-bold">👤</div>
      <div>
        <h3 class="font-bold">الزائر: <%= visitorId %></h3>
        <p class="text-xs text-slate-400">الحالة: <%= session.status === 'closed' ? 'مغلقة' : 'مفتوحة' %></p>
      </div>
    </div>
    <div class="flex gap-2">
      <% if(session.status !== 'closed') { %>
        <button id="close-chat-btn" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-sm font-bold transition">إغلاق المحادثة</button>
      <% } %>
      <a href="/admin/chats" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg text-sm font-bold transition">رجوع</a>
    </div>
  </div>
  
  <% if(session.rating > 0) { %>
    <div class="bg-amber-100 text-amber-800 p-3 text-center font-bold text-sm border-b border-amber-200">
      تقييم الزبون: <%= '⭐'.repeat(session.rating) %> | ملاحظات: <%= session.feedback || 'لا يوجد' %>
    </div>
  <% } %>

  <div id="chat-box" class="flex-1 p-4 overflow-y-auto flex flex-col gap-3 bg-slate-50"></div>

  <div class="p-4 bg-white border-t flex gap-2">
    <input id="msg-input" type="text" placeholder="اكتب ردك هنا..." class="flex-1 border p-3 rounded-xl outline-none focus:border-blue-500" <%= session.status === 'closed' ? 'disabled' : '' %>>
    <button id="send-btn" class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 disabled:opacity-50" <%= session.status === 'closed' ? 'disabled' : '' %>>إرسال</button>
  </div>

  <script>
    const visitorId = "<%= visitorId %>";
    const chatBox = document.getElementById('chat-box');
    const input = document.getElementById('msg-input');
    let lastMsgCount = 0;

    async function loadMessages() {
      const res = await fetch('/api/admin/chat/messages/' + visitorId);
      const data = await res.json();
      
      if (data.messages.length !== lastMsgCount) {
        chatBox.innerHTML = '';
        data.messages.forEach(m => {
          const isAdmin = m.sender === 'admin';
          const isSystem = m.sender === 'system';
          if (isSystem) {
            chatBox.innerHTML += `<div class="text-center text-red-500 text-xs font-bold my-2">${m.message}</div>`;
            return;
          }
          chatBox.innerHTML += `
            <div class="max-w-[75%] p-3 rounded-xl text-sm ${isAdmin ? 'bg-blue-600 text-white self-end rounded-br-none' : 'bg-white border text-slate-800 self-start rounded-bl-none'}">
              ${m.message}
              <div class="text-[10px] mt-1 opacity-70 text-left" dir="ltr">${m.created_at.split(' ')[1]}</div>
            </div>`;
        });
        chatBox.scrollTop = chatBox.scrollHeight;
        lastMsgCount = data.messages.length;
      }
    }

    async function sendMsg() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      await fetch('/api/admin/chat/send', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitor_id: visitorId, message: text })
      });
      loadMessages();
    }

    document.getElementById('send-btn').onclick = sendMsg;
    input.addEventListener('keypress', e => { if (e.key === 'Enter') sendMsg(); });

    const closeBtn = document.getElementById('close-chat-btn');
    if (closeBtn) {
      closeBtn.onclick = async () => {
        if (confirm('هل أنت متأكد من إغلاق المحادثة؟ سيتمكن الزبون من تقييمها.')) {
          await fetch('/api/admin/chat/close/' + visitorId, { method: 'POST' });
          window.location.reload();
        }
      };
    }

    setInterval(loadMessages, 3000);
    loadMessages();
  </script>
</body>
</html>
