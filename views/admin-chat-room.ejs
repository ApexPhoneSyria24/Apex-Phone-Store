<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>محادثة مع <%= visitorId %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
  <style>
    body { background-color: #0a192f; color: #e6f1ff; margin: 0; padding: 0; overflow: hidden; position: fixed; width: 100%; height: 100%; }
    #chat-box::-webkit-scrollbar { width: 5px; }
    #chat-box::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
  </style>
</head>
<body class="font-sans flex flex-col">
  
  <div class="bg-[#112240] border-b border-[#233554] p-4 flex justify-between items-center flex-shrink-0 shadow-md z-10">
    <div class="flex items-center gap-3">
      <a href="/admin/chats" class="bg-[#0a192f] hover:bg-[#233554] text-[#8892b0] w-10 h-10 rounded-full flex items-center justify-center transition"><i class="fa-solid fa-arrow-right"></i></a>
      <div class="w-12 h-12 bg-[#00f3ff] rounded-full flex items-center justify-center text-xl">
        <i class="fa-solid fa-user text-black"></i>
      </div>
      <div>
        <h3 class="font-black text-lg text-white">الزائر: <span dir="ltr" class="text-[#00f3ff]"><%= visitorId %></span></h3>
        <p class="text-xs text-[#8892b0]"><%= session.status === 'closed' ? '🔴 مغلقة' : '🟢 نشطة الآن' %></p>
      </div>
    </div>
    <div class="flex gap-2">
      <% if(session.status !== 'closed') { %>
        <button id="close-chat-btn" class="bg-red-500/10 text-red-400 border border-red-500/30 hover:bg-red-500 hover:text-white px-4 py-2 rounded-lg text-sm font-bold transition flex items-center gap-2">
          <i class="fa-solid fa-lock"></i> إغلاق
        </button>
      <% } %>
    </div>
  </div>

  <% if(session.rating > 0) { %>
    <div class="bg-[#112240] border-b border-[#233554] text-amber-400 p-2 text-center font-bold text-sm flex-shrink-0">
      تقييم الزبون: <%= '⭐'.repeat(session.rating) %>
    </div>
  <% } %>

  <div id="chat-box" class="flex-1 p-5 overflow-y-auto flex flex-col gap-1 bg-[#0a192f]" style="min-height: 0;"></div>

  <div class="bg-[#112240] border-t border-[#233554] p-3 flex gap-3 flex-shrink-0">
    <input id="msg-input" type="text" placeholder="اكتب رسالة..." class="flex-1 bg-[#0a192f] border-none rounded-full px-5 py-3 text-[#e6f1ff] focus:outline-none" <%= session.status === 'closed' ? 'disabled' : '' %>>
    <button id="send-btn" class="bg-[#00f3ff] text-black w-12 h-12 rounded-full flex items-center justify-center text-xl hover:opacity-90 transition disabled:opacity-50" <%= session.status === 'closed' ? 'disabled' : '' %>>
      <i class="fa-solid fa-paper-plane"></i>
    </button>
  </div>

  <script>
    if (window.visualViewport) {
      const adjustViewport = () => {
        document.body.style.height = window.visualViewport.height + 'px';
        document.body.style.top = window.visualViewport.offsetTop + 'px';
        const chatBox = document.getElementById('chat-box');
        if(chatBox) chatBox.scrollTop = chatBox.scrollHeight;
      };
      window.visualViewport.addEventListener('resize', adjustViewport);
      window.visualViewport.addEventListener('scroll', adjustViewport);
      adjustViewport();
    }

    const visitorId = "<%= visitorId %>";
    const chatBox = document.getElementById('chat-box');
    const input = document.getElementById('msg-input');
    let lastMsgCount = 0;

    async function loadMessages() {
      try {
        const res = await fetch('/api/admin/chat/messages/' + visitorId);
        const data = await res.json();
        
        if (data.messages.length !== lastMsgCount) {
          chatBox.innerHTML = '';
          data.messages.forEach(m => {
            const isAdmin = m.sender === 'admin';
            const isSystem = m.sender === 'system';
            
            if (isSystem) {
              chatBox.innerHTML += `<div class="text-center text-[#ef4444] bg-[#ef4444]/10 p-2 rounded text-xs font-bold w-fit mx-auto my-2 border border-[#ef4444]/20 whitespace-pre-wrap">${m.message}</div>`;
              return;
            }

            const tick = m.sender === 'visitor' ? (m.is_read ? '<i class="fa-solid fa-check-double text-[#00f3ff]"></i>' : '<i class="fa-solid fa-check text-[#8892b0]"></i>') : '';

            chatBox.innerHTML += `
              <div class="max-w-[80%] p-2 px-3 rounded-lg text-sm leading-relaxed ${isAdmin ? 'bg-[#0055ff] text-white self-start rounded-tr-none shadow-sm' : 'bg-[#112240] text-[#e6f1ff] self-end rounded-tl-none shadow-sm'} mb-1">
                ${m.message}
                <div class="text-[10px] text-[#8892b0] text-left mt-1 flex justify-end items-center gap-1" dir="ltr">
                  ${m.created_at.split(' ')[1].substring(0,5)} ${tick}
                </div>
              </div>`;
          });
          chatBox.scrollTop = chatBox.scrollHeight;
          lastMsgCount = data.messages.length;
        }
      } catch(e) { console.error(e); }
    }

    async function sendMsg() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      await fetch('/api/admin/chat/send', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitor_id: visitorId, message: text })
      });
      loadMessages();
    }

    document.getElementById('send-btn').onclick = sendMsg;
    input.addEventListener('keypress', e => { if (e.key === 'Enter') sendMsg(); });

    const closeBtn = document.getElementById('close-chat-btn');
    if (closeBtn) {
      closeBtn.onclick = async () => {
        if (confirm('هل أنت متأكد من إغلاق المحادثة؟ سيتمكن الزبون من تقييمها أو بدء محادثة جديدة.')) {
          await fetch('/api/admin/chat/close/' + visitorId, { method: 'POST' });
          window.location.reload();
        }
      };
    }

    setInterval(loadMessages, 2000);
    loadMessages();
  </script>
</body>
</html>
