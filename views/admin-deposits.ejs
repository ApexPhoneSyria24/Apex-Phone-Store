<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة إيداعات الرصيد</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 min-h-screen font-sans">
  <nav class="bg-slate-900 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
      <h1 class="font-black text-lg"><i class="fa-solid fa-wallet text-cyan-400"></i> إدارة إيداعات الرصيد</h1>
      <a href="/admin" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg font-bold text-sm transition"><i class="fa-solid fa-arrow-right"></i> لوحة الإدارة</a>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto p-4 md:p-6">
    <% if (message) { %><div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4 font-bold"><%= message %></div><% } %>
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-right text-sm">
          <thead class="bg-slate-100 text-slate-600">
            <tr><th class="p-3">#</th><th class="p-3">الهاتف</th><th class="p-3">المبلغ ($)</th><th class="p-3">الليرة</th><th class="p-3">رقم العملية</th><th class="p-3">الإشعار</th><th class="p-3">الحالة</th><th class="p-3">الإجراءات</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% deposits.forEach(d => { %>
              <tr class="hover:bg-slate-50">
                <td class="p-3 text-slate-500"><%= d.id %></td>
                <td class="p-3 font-bold" dir="ltr"><%= d.user_phone %></td>
                <td class="p-3 font-black text-green-600">$<%= d.amount_usd %></td>
                <td class="p-3 text-slate-600 font-bold" dir="ltr"><%= d.amount_syp %> <span class="text-xs">ل.س</span></td>
                <td class="p-3 text-xs text-slate-500" dir="ltr"><%= d.transfer_ref || '-' %></td>
                <td class="p-3">
                  <% if (d.receipt_image) { %><a href="<%= d.receipt_image %>" target="_blank" class="text-blue-500 hover:underline text-xs font-bold"><i class="fa-solid fa-image"></i> عرض</a>
                  <% } else { %> - <% } %>
                </td>
                <td class="p-3">
                  <% if (d.status === 'approved') { %><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">مقبول</span>
                  <% } else if (d.status === 'rejected') { %><span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold">مرفوض</span>
                  <% } else { %><span class="bg-amber-100 text-amber-700 px-2 py-1 rounded text-xs font-bold">قيد المراجعة</span><% } %>
                </td>
                <td class="p-3">
                  <% if (d.status === 'pending') { %>
                    <div class="flex gap-1">
                      <form action="/admin/deposits/approve/<%= d.id %>" method="POST" class="inline" onsubmit="return confirm('تأكيد إضافة الرصيد؟')"><button class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold hover:bg-green-200"><i class="fa-solid fa-check"></i></button></form>
                      <form action="/admin/deposits/reject/<%= d.id %>" method="POST" class="inline" onsubmit="return confirm('رفض الطلب؟')"><button class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold hover:bg-red-200"><i class="fa-solid fa-xmark"></i></button></form>
                    </div>
                  <% } else { %> - <% } %>
                </td>
              </tr>
            <% }) %>
            <% if(deposits.length === 0) { %><tr><td colspan="8" class="p-6 text-center text-slate-500 font-bold">لا توجد طلبات إيداع.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
