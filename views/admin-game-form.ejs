<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= isEdit ? 'تعديل' : 'إضافة' %> لعبة</title><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><script src="https://cdn.tailwindcss.com"></script><script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script></head>
<body class="bg-slate-100 min-h-screen font-sans">
  <nav class="bg-slate-900 text-white shadow-lg"><div class="max-w-5xl mx-auto px-4 h-16 flex justify-between items-center"><h1 class="font-black text-lg"><i class="fa-solid fa-<%= isEdit ? 'pen' : 'plus' %> text-cyan-400"></i> <%= isEdit ? 'تعديل لعبة' : 'إضافة لعبة جديدة' %></h1><a href="/admin/games" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg font-bold text-sm transition"><i class="fa-solid fa-arrow-right"></i> رجوع</a></div></nav>
  <div class="max-w-5xl mx-auto p-4 md:p-6 space-y-6">
    <% if (error) { %><div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg font-bold"><%= error %></div><% } %>
    <% if (typeof message !== 'undefined' && message) { %><div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg font-bold"><%= message %></div><% } %>
    <form action="<%= isEdit ? '/admin/games/' + game.id + '/edit' : '/admin/games/new' %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <h2 class="font-black text-lg text-slate-800 border-b pb-2"><i class="fa-solid fa-circle-info text-cyan-500"></i> معلومات اللعبة</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-bold text-slate-700 mb-1">الاسم (بالإنجليزية) *</label><input type="text" name="name" required value="<%= game ? game.name : '' %>" placeholder="مثال: PUBG Mobile" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">الاسم بالعربية</label><input type="text" name="name_ar" value="<%= game && game.name_ar ? game.name_ar : '' %>" placeholder="مثال: ببجي موبايل" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">Slug (اختياري)</label><input type="text" name="slug" value="<%= game && game.slug ? game.slug : '' %>" placeholder="pubg-mobile" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">المطور</label><input type="text" name="developer" value="<%= game && game.developer ? game.developer : '' %>" placeholder="Tencent Games" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">وقت التسليم</label><input type="text" name="delivery_time" value="<%= game && game.delivery_time ? game.delivery_time : '' %>" placeholder="خلال 5-15 دقيقة" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">ترتيب العرض</label><input type="number" name="sort_order" value="<%= game && game.sort_order !== undefined ? game.sort_order : 0 %>" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none"></div>
      </div>
      <div><label class="block text-sm font-bold text-slate-700 mb-1">الوصف</label><textarea name="description" rows="3" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none" placeholder="وصف اللعبة..."><%= game && game.description ? game.description : '' %></textarea></div>
      <div><label class="block text-sm font-bold text-slate-700 mb-1">طريقة الشحن / المتطلبات</label><textarea name="instructions" rows="2" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none" placeholder="أدخل Player ID..."><%= game && game.instructions ? game.instructions : '' %></textarea></div>
      <div><label class="block text-sm font-bold text-slate-700 mb-1">سياسة الاسترجاع</label><textarea name="refund_policy" rows="2" class="w-full border border-slate-300 rounded-lg p-2 focus:border-cyan-500 outline-none" placeholder="لا يمكن استرداد الطلب بعد الشحن..."><%= game && game.refund_policy ? game.refund_policy : '' %></textarea></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-bold text-slate-700 mb-1">شعار اللعبة (512×512)</label><% if (game && game.image_url) { %><img src="<%= game.image_url %>" class="w-16 h-16 rounded object-cover mb-2 border"><% } %><input type="file" name="logo" accept="image/*" class="w-full border border-slate-300 rounded-lg p-2 text-sm"></div>
        <div><label class="block text-sm font-bold text-slate-700 mb-1">بانر الصفحة (1200×400)</label><% if (game && game.banner_url) { %><img src="<%= game.banner_url %>" class="w-24 h-10 rounded object-cover mb-2 border"><% } %><input type="file" name="banner" accept="image/*" class="w-full border border-slate-300 rounded-lg p-2 text-sm"></div>
      </div>
      <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-lg"><input type="checkbox" name="is_active" id="is_active" <%= (!game || game.is_active === 1) ? 'checked' : '' %> class="w-4 h-4"><label for="is_active" class="font-bold text-slate-700 text-sm">مفعّلة وتظهر للزوار</label></div>
      <div class="flex gap-3 pt-2"><button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white font-black py-3 rounded-lg transition"><i class="fa-solid fa-save"></i> <%= isEdit ? 'حفظ التعديلات' : 'إنشاء اللعبة' %></button><a href="/admin/games" class="flex-1 text-center bg-slate-200 hover:bg-slate-300 text-slate-700 font-black py-3 rounded-lg transition">إلغاء</a></div>
    </form>
    <% if (isEdit) { %>
      <div class="bg-white rounded-xl shadow-sm border p-6">
        <h2 class="font-black text-lg text-slate-800 border-b pb-2 mb-4"><i class="fa-solid fa-boxes-stacked text-green-500"></i> إدارة الباقات (<%= packages.length %>)</h2>
        <% if (packages.length === 0) { %><div class="text-center py-6 text-slate-500 font-bold">لا توجد باقات. أضف أول باقة من الأسفل.</div><% } else { %>
          <div class="overflow-x-auto mb-4"><table class="w-full text-right text-sm"><thead class="bg-slate-100"><tr><th class="p-2 font-bold">اسم الباقة</th><th class="p-2 font-bold">السعر ($)</th><th class="p-2 font-bold">ترتيب</th><th class="p-2 font-bold">الحالة</th><th class="p-2 font-bold">إجراء</th></tr></thead><tbody>
            <% packages.forEach(p => { %><tr class="border-b hover:bg-slate-50"><td class="p-2 font-bold"><%= p.package_name %></td><td class="p-2 text-green-600 font-black">$<%= p.price %></td><td class="p-2 text-slate-600"><%= p.sort_order %></td><td class="p-2"><% if (p.is_active === 1) { %><span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold">مفعّلة</span><% } else { %><span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-bold">مخفية</span><% } %></td><td class="p-2"><form action="/admin/packages/delete/<%= p.id %>" method="POST" onsubmit="return confirm('حذف الباقة؟')" class="inline"><button class="text-red-500 hover:text-red-700 font-bold text-xs"><i class="fa-solid fa-trash"></i> حذف</button></form></td></tr><% }) %>
          </tbody></table></div>
        <% } %>
        <form action="/admin/packages/add" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-2 bg-slate-50 p-3 rounded-lg"><input type="hidden" name="game_name" value="<%= game.name %>"><input type="text" name="package_name" required placeholder="اسم الباقة (مثال: 660 UC)" class="border border-slate-300 rounded-lg p-2 text-sm"><input type="number" step="0.01" name="price" required placeholder="السعر ($)" class="border border-slate-300 rounded-lg p-2 text-sm"><input type="number" name="sort_order" value="0" placeholder="ترتيب" class="border border-slate-300 rounded-lg p-2 text-sm"><button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg py-2 text-sm transition"><i class="fa-solid fa-plus"></i> إضافة باقة</button></form>
      </div>
    <% } %>
  </div>
</body>
</html>
