<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEdit ? 'تعديل' : 'إضافة' %> لعبة</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 min-h-screen font-sans">
  <nav class="bg-slate-900 text-white shadow-lg">
    <div class="max-w-5xl mx-auto px-4 h-16 flex justify-between items-center">
      <h1 class="font-black text-lg"><%= isEdit ? 'تعديل لعبة' : 'إضافة لعبة جديدة' %></h1>
      <a href="/admin/games" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg font-bold text-sm transition">رجوع</a>
    </div>
  </nav>

  <div class="max-w-5xl mx-auto p-4 md:p-6 space-y-6">
    <div id="statusMessage" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg font-bold"></div>

    <form id="gameForm" action="<%= isEdit ? '/admin/games/' + game.id + '/edit' : '/admin/games/new' %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">الاسم (بالإنجليزية) *</label>
          <input type="text" name="name" required value="<%= game ? game.name : '' %>" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-cyan-500">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">الاسم بالعربية</label>
          <input type="text" name="name_ar" value="<%= game && game.name_ar ? game.name_ar : '' %>" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-cyan-500">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">المطور</label>
          <input type="text" name="developer" value="<%= game && game.developer ? game.developer : '' %>" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-cyan-500">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">وقت التسليم</label>
          <input type="text" name="delivery_time" value="<%= game && game.delivery_time ? game.delivery_time : '' %>" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-cyan-500">
        </div>
      </div>

      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1">الوصف</label>
        <textarea name="description" rows="2" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-cyan-500"><%= game && game.description ? game.description : '' %></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">شعار اللعبة (512×512)</label>
          <% if (game && game.image_url) { %><img src="<%= game.image_url %>" class="w-12 h-12 rounded object-cover mb-2 border"><% } %>
          <input type="file" name="logo" accept="image/*" class="w-full border border-slate-300 rounded-lg p-2 text-sm">
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">بانر الصفحة (1200×400)</label>
          <% if (game && game.banner_url) { %><img src="<%= game.banner_url %>" class="w-20 h-10 rounded object-cover mb-2 border"><% } %>
          <input type="file" name="banner" accept="image/*" class="w-full border border-slate-300 rounded-lg p-2 text-sm">
        </div>
      </div>

      <div class="flex items-center gap-2 bg-slate-50 p-3 rounded-lg">
        <input type="checkbox" name="is_active" id="is_active" <%= (!game || game.is_active === 1) ? 'checked' : '' %> class="w-4 h-4">
        <label for="is_active" class="font-bold text-slate-700 text-sm">مفعّلة وتظهر للزوار</label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" id="submitBtn" class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white font-black py-3 rounded-lg transition">حفظ اللعبة</button>
        <a href="/admin/games" class="flex-1 text-center bg-slate-200 hover:bg-slate-300 text-slate-700 font-black py-3 rounded-lg transition">إلغاء</a>
      </div>
    </form>

    <% if (isEdit) { %>
      <div class="bg-white rounded-xl shadow-sm border p-6">
        <h2 class="font-black text-lg text-slate-800 border-b pb-2 mb-4">إدارة الباقات</h2>
        <form action="/admin/packages/add" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-2 bg-slate-50 p-3 rounded-lg">
          <input type="hidden" name="game_name" value="<%= game.name %>">
          <input type="text" name="package_name" required placeholder="اسم الباقة" class="border border-slate-300 rounded-lg p-2 text-sm">
          <input type="number" step="0.01" name="price" required placeholder="السعر ($)" class="border border-slate-300 rounded-lg p-2 text-sm">
          <input type="number" name="sort_order" value="0" placeholder="ترتيب" class="border border-slate-300 rounded-lg p-2 text-sm">
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg py-2 text-sm">إضافة</button>
        </form>
      </div>
    <% } %>
  </div>

  <script>
    // ميزة سحرية: ضغط الصور في المتصفح قبل الرفع لتكون أسرع 10 مرات
    async function compressImage(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (event) => {
          const img = new Image();
          img.src = event.target.result;
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 1200;
            const scale = MAX_WIDTH / img.width;
            canvas.width = MAX_WIDTH;
            canvas.height = img.height * scale;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob((blob) => {
              resolve(new File([blob], file.name, { type: 'image/jpeg' }));
            }, 'image/jpeg', 0.8); // ضغط 80%
          };
        };
      });
    }

    document.getElementById('gameForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      const statusDiv = document.getElementById('statusMessage');
      btn.innerHTML = '⏳ جاري الرفع (بدون إعادة تحميل)...';
      btn.disabled = true;

      const formData = new FormData(this);
      
      // ضغط الصور قبل الإرسال
      const logo = this.querySelector('input[name="logo"]').files[0];
      const banner = this.querySelector('input[name="banner"]').files[0];
      if (logo) formData.set('logo', await compressImage(logo));
      if (banner) formData.set('banner', await compressImage(banner));

      try {
        const res = await fetch(this.action, { method: 'POST', body: formData });
        if (res.redirected) {
          window.location.href = res.url; // الانتقال السريع
        } else {
          statusDiv.classList.remove('hidden');
          statusDiv.innerHTML = '✅ تم الحفظ بنجاح!';
          btn.innerHTML = '✅ تم الحفظ';
          setTimeout(() => { btn.innerHTML = 'حفظ اللعبة'; btn.disabled = false; }, 2000);
        }
      } catch (err) {
        alert('حدث خطأ أثناء الرفع');
        btn.innerHTML = 'حفظ اللعبة';
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
