<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><title>إدارة شحن الألعاب</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 min-h-screen p-4">
<nav class="bg-white shadow-sm border-b border-slate-200 mb-6">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center h-14">
    <h1 class="text-lg font-extrabold text-slate-900"><i class="fa-solid fa-gamepad text-blue-600 mr-2"></i> إدارة شحن الألعاب</h1>
    <div class="flex gap-2">
      <a href="/admin/games/add" class="bg-blue-600 text-white px-4 py-2 rounded-lg font-bold text-sm">+ إضافة باقة</a>
      <a href="/admin" class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg font-bold text-sm">عودة للإدارة</a>
    </div>
  </div>
</nav>
<div class="max-w-7xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <table class="w-full text-right border-collapse">
    <thead><tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm"><th class="p-4">اللعبة</th><th class="p-4">الباقة</th><th class="p-4">السعر</th><th class="p-4">الحالة</th><th class="p-4">إجراءات</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% packages.forEach(p => { %>
        <tr class="hover:bg-slate-50">
          <td class="p-4 font-bold text-slate-800"><%= p.game_name %></td>
          <td class="p-4 text-slate-600"><%= p.package_name %></td>
          <td class="p-4 font-extrabold text-green-600">$<%= p.price %></td>
          <td class="p-4"><span class="<%= p.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %> px-2 py-1 rounded text-xs font-bold"><%= p.is_active ? 'مفعل' : 'معطل' %></span></td>
          <td class="p-4 flex gap-2">
            <a href="/admin/games/edit/<%= p.id %>" class="bg-amber-100 text-amber-600 px-3 py-1.5 rounded text-xs font-bold">تعديل</a>
            <form action="/admin/games/delete/<%= p.id %>" method="POST" onsubmit="return confirm('حذف؟')"><button class="bg-red-100 text-red-600 px-3 py-1.5 rounded text-xs font-bold">حذف</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
