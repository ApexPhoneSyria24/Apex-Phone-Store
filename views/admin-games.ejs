
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title>إدارة الألعاب</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body class="bg-slate-50 min-h-screen p-4">
<nav class="bg-white shadow-sm border-b mb-6"><div class="max-w-7xl mx-auto px-4 h-14 flex justify-between items-center"><h1 class="font-bold text-lg">إدارة الألعاب والباقات</h1><a href="/admin" class="bg-slate-100 px-4 py-2 rounded-lg font-bold text-sm">عودة</a></div></nav>
<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
  <div class="bg-white p-6 rounded-xl shadow-sm border"><h3 class="font-bold mb-4">إضافة / تعديل صورة لعبة</h3>
    <form action="/admin/games/add" method="POST" enctype="multipart/form-data" class="space-y-3">
      <input type="text" name="game_name" placeholder="اسم اللعبة (مثال: PUBG Mobile)" class="w-full border p-2 rounded" required>
      <input type="file" name="game_image" accept="image/*" class="w-full border p-2 rounded" required>
      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded font-bold">حفظ الصورة</button>
    </form>
  </div>
  <div class="bg-white p-6 rounded-xl shadow-sm border"><h3 class="font-bold mb-4">إضافة باقة</h3>
    <form action="/admin/packages/add" method="POST" class="space-y-3">
      <input type="text" name="game_name" placeholder="اسم اللعبة (يجب أن يطابق)" class="w-full border p-2 rounded" required>
      <input type="text" name="package_name" placeholder="اسم الباقة (مثال: 60 UC)" class="w-full border p-2 rounded" required>
      <input type="number" step="0.01" name="price" placeholder="السعر ($)" class="w-full border p-2 rounded" required>
      <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded font-bold">حفظ الباقة</button>
    </form>
  </div>
</div>
<div class="max-w-7xl mx-auto space-y-6">
  <% Object.entries(groupedPackages).forEach(([gameName, pkgs]) => { 
      const game = games.find(g => g.name === gameName);
  %>
    <div class="bg-white p-6 rounded-xl shadow-sm border">
      <div class="flex items-center gap-4 mb-4">
        <% if(game && game.image_url) { %><img src="<%= game.image_url %>" class="w-16 h-16 rounded-lg object-cover"><% } else { %><div class="w-16 h-16 rounded-lg bg-slate-200 flex items-center justify-center"><i class="fa-solid fa-gamepad text-slate-400"></i></div><% } %>
        <h3 class="text-xl font-bold text-slate-800"><%= gameName %></h3>
      </div>
      <table class="w-full text-right text-sm"><tr class="bg-slate-50 border-b"><th class="p-2">الباقة</th><th class="p-2">السعر</th><th class="p-2">إجراء</th></tr>
        <% pkgs.forEach(p => { %>
          <tr class="border-b"><td class="p-2"><%= p.package_name %></td><td class="p-2 text-green-600 font-bold">$<%= p.price %></td><td class="p-2"><form action="/admin/packages/delete/<%= p.id %>" method="POST" onsubmit="return confirm('حذف؟')"><button class="text-red-500 font-bold">حذف</button></form></td></tr>
        <% }) %>
      </table>
    </div>
  <% }) %>
</div>
</body>
</html>
