<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة الألعاب</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 min-h-screen font-sans">
  <nav class="bg-slate-900 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
      <h1 class="font-black text-lg"><i class="fa-solid fa-gamepad text-cyan-400"></i> إدارة الألعاب</h1>
      <div class="flex gap-2">
        <a href="/admin" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg font-bold text-sm transition"><i class="fa-solid fa-arrow-right"></i> لوحة الإدارة</a>
        <a href="/admin/games/new" class="bg-cyan-500 hover:bg-cyan-600 px-4 py-2 rounded-lg font-bold text-sm transition"><i class="fa-solid fa-plus"></i> لعبة جديدة</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto p-4 md:p-6">
    <% if (message) { %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4 font-bold"><%= message %></div>
    <% } %>

    <% if (games.length === 0) { %>
      <div class="bg-white rounded-xl p-12 text-center shadow-sm border">
        <i class="fa-solid fa-ghost text-5xl text-slate-300 mb-4"></i>
        <h3 class="text-xl font-black text-slate-700 mb-2">لا توجد ألعاب بعد</h3>
        <p class="text-slate-500 mb-6">ابدأ بإضافة أول لعبة إلى قسم الشحن.</p>
        <a href="/admin/games/new" class="inline-block bg-cyan-500 hover:bg-cyan-600 text-white px-6 py-3 rounded-lg font-bold"><i class="fa-solid fa-plus"></i> إضافة لعبة</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% games.forEach(g => { %>
          <div class="bg-white rounded-xl shadow-sm border overflow-hidden hover:shadow-md transition">
            <div class="flex items-center gap-3 p-4 border-b">
              <div class="w-16 h-16 rounded-lg overflow-hidden bg-slate-100 flex-shrink-0">
                <% if (g.image_url) { %>
                  <img src="<%= g.image_url %>" class="w-full h-full object-cover">
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-slate-300"><i class="fa-solid fa-gamepad text-2xl"></i></div>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-black text-slate-800 truncate"><%= g.name_ar || g.name %></h3>
                <p class="text-xs text-slate-500 truncate"><%= g.name %></p>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-xs bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-bold"><%= g.packages_count %> باقة</span>
                  <% if (g.is_active === 1) { %>
                    <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold">مفعّلة</span>
                  <% } else { %>
                    <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-bold">مخفية</span>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="p-3 flex gap-2 bg-slate-50">
              <a href="/admin/games/<%= g.id %>/edit" class="flex-1 text-center bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg text-xs font-bold transition"><i class="fa-solid fa-pen"></i> تعديل</a>
              <form action="/admin/games/<%= g.id %>/toggle" method="POST" class="flex-1">
                <button class="w-full bg-amber-500 hover:bg-amber-600 text-white py-2 rounded-lg text-xs font-bold transition">
                  <i class="fa-solid fa-eye<%= g.is_active === 1 ? '-slash' : '' %>"></i> <%= g.is_active === 1 ? 'إخفاء' : 'إظهار' %>
                </button>
              </form>
              <form action="/admin/games/<%= g.id %>/delete" method="POST" class="flex-1" onsubmit="return confirm('حذف اللعبة وكل باقاتها؟ لا يمكن التراجع.')">
                <button class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg text-xs font-bold transition"><i class="fa-solid fa-trash"></i> حذف</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
<script src="/tracker.js"></script>
</body>
</html>
