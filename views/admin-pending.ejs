<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>طلبات الإعلانات | Apex فون</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Almarai', 'sans-serif'] }, colors: { brand: { 500: '#2563eb', 600: '#1d4ed8' } } } } }</script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1BPM70EPWG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-1BPM70EPWG');
</script>
</head>
<body class="font-sans bg-slate-50 text-slate-800 antialiased min-h-screen">

<nav class="bg-white shadow-sm border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-3 flex justify-between items-center h-12">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 bg-amber-500 rounded-lg flex items-center justify-center text-white text-xs"><i class="fa-solid fa-bell"></i></div>
      <span class="text-sm font-extrabold text-slate-900">طلبات الإعلانات</span>
    </div>
    <div class="flex gap-2">
      <a href="/admin" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-[10px]"><i class="fa-solid fa-arrow-right"></i> عودة للإدارة</a>
    </div>
  </div>
</nav>

<main class="max-w-7xl mx-auto px-3 py-6">
  <% if (ads.length === 0) { %>
    <div class="text-center py-12 bg-white rounded-xl border border-slate-200">
      <i class="fa-solid fa-inbox text-4xl text-slate-200 mb-2"></i>
      <h3 class="text-sm font-bold text-slate-700">لا توجد طلبات جديدة</h3>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% ads.forEach(ad => { %>
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4">
          <div class="flex items-center gap-3 mb-3 pb-3 border-b border-slate-100">
            <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center text-slate-400"><i class="fa-solid fa-user"></i></div>
            <div>
              <p class="text-sm font-extrabold text-slate-900"><%= ad.seller_name %></p>
              <p class="text-[10px] text-brand-600 font-bold" dir="ltr"><%= ad.seller_phone %></p>
            </div>
          </div>
          
          <div class="mb-4">
            <h4 class="text-xs font-extrabold text-slate-800"><%= ad.brand %> - <%= ad.name %></h4>
            <p class="text-sm font-extrabold text-green-600 mt-1">$<%= ad.price %></p>
          </div>

          <div class="flex gap-2">
            <a href="https://wa.me/963<%= ad.seller_phone.replace(/^0/, '') %>" target="_blank" class="flex-1 bg-green-500 hover:bg-green-600 text-white text-center py-2 rounded-lg font-bold text-xs transition"><i class="fa-brands fa-whatsapp"></i> واتساب</a>
            <a href="tel:<%= ad.seller_phone %>" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-center py-2 rounded-lg font-bold text-xs transition"><i class="fa-solid fa-phone"></i> اتصال</a>
          </div>

          <div class="flex gap-2 mt-2">
            <form action="/admin/approve/<%= ad.id %>" method="POST" class="flex-1">
              <button type="submit" class="w-full bg-slate-900 hover:bg-black text-white py-2 rounded-lg font-bold text-xs transition"><i class="fa-solid fa-check"></i> موافقة ونشر</button>
            </form>
            <form action="/admin/reject/<%= ad.id %>" method="POST" class="flex-1" onsubmit="return confirm('رفض الإعلان؟')">
              <button type="submit" class="w-full bg-red-100 hover:bg-red-200 text-red-600 py-2 rounded-lg font-bold text-xs transition"><i class="fa-solid fa-xmark"></i> رفض</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<script src="/tracker.js"></script>
</body>
</html>
