<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>إدارة التقييمات | Apex فون</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Almarai', 'sans-serif'] }, colors: { brand: { 500: '#2563eb', 600: '#1d4ed8' } } } } }</script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1BPM70EPWG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-1BPM70EPWG');
</script>
</head>
<body class="font-sans bg-slate-50 text-slate-800 antialiased min-h-screen">

<nav class="bg-white shadow-sm border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-3 flex justify-between items-center h-12">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 bg-amber-400 rounded-lg flex items-center justify-center text-white text-xs"><i class="fa-solid fa-star"></i></div>
      <span class="text-sm font-extrabold text-slate-900">إدارة التقييمات</span>
    </div>
    <a href="/admin" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1 text-[10px]"><i class="fa-solid fa-arrow-right"></i> عودة للإدارة</a>
  </div>
</nav>

<main class="max-w-7xl mx-auto px-3 py-6">
  <% if (reviews.length === 0) { %>
    <div class="text-center py-12 bg-white rounded-xl border border-slate-200">
      <i class="fa-solid fa-star-half-stroke text-4xl text-slate-200 mb-2"></i>
      <h3 class="text-sm font-bold text-slate-700">لا توجد تقييمات حتى الآن</h3>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% reviews.forEach(r => { %>
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 <%= r.status === 'approved' ? 'border-green-300' : 'border-amber-300' %>">
          <div class="flex items-center justify-between mb-2 pb-2 border-b">
            <div>
              <p class="text-xs font-extrabold text-slate-900"><%= r.reviewer_name %></p>
              <p class="text-[9px] text-brand-600 font-bold">على: <%= r.phone_name || 'جهاز محذوف' %></p>
            </div>
            <div class="text-amber-400 text-[10px]"><% for(let i=1; i<=5; i++) { %><i class="fa-solid fa-star <%= i <= r.rating ? '' : 'text-slate-300' %>"></i><% } %></div>
          </div>
          <p class="text-[10px] text-slate-600 font-bold mb-4 h-10 overflow-hidden"><%= r.comment %></p>
          
          <div class="flex gap-2">
            <% if (r.status !== 'approved') { %>
              <form action="/admin/review/approve/<%= r.id %>" method="POST" class="flex-1">
                <button type="submit" class="w-full bg-green-500 text-white py-1.5 rounded font-bold text-[10px] hover:bg-green-600 transition"><i class="fa-solid fa-check"></i> موافقة (نشر)</button>
              </form>
            <% } else { %>
              <span class="flex-1 text-center bg-green-50 text-green-700 py-1.5 rounded font-bold text-[10px] border border-green-200">تم النشر ✔️</span>
            <% } %>
            <form action="/admin/review/delete/<%= r.id %>" method="POST" class="flex-1" onsubmit="return confirm('حذف التقييم؟')">
              <button type="submit" class="w-full bg-red-100 text-red-600 py-1.5 rounded font-bold text-[10px] hover:bg-red-200 transition"><i class="fa-solid fa-trash"></i> حذف</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

</body>
</html>
