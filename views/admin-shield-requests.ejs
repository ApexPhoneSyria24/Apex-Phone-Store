<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"><title>درع الوساطة</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 p-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-black text-slate-800"><i class="fa-solid fa-shield-halved text-cyan-600"></i> طلبات الوساطة (Apex Shield)</h1>
      <a href="/admin" class="bg-slate-800 text-white px-4 py-2 rounded-lg font-bold">عودة للإدارة</a>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border overflow-x-auto">
      <table class="w-full text-right text-sm whitespace-nowrap">
        <thead class="bg-slate-100 text-slate-600">
          <tr>
            <th class="p-3">#</th>
            <th class="p-3">المشتري</th>
            <th class="p-3">البائع</th>
            <th class="p-3">المبلغ</th>
            <th class="p-3">الهويات</th>
            <th class="p-3">حالة الطلب</th>
            <th class="p-3">إجراءات</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% requests.forEach(r => { %>
            <tr class="hover:bg-slate-50">
              <td class="p-3 text-slate-500"><%= r.id %></td>
              <td class="p-3 font-bold" dir="ltr"><%= r.buyer_phone %></td>
              <td class="p-3 font-bold" dir="ltr"><%= r.seller_phone %></td>
              <td class="p-3 font-bold text-green-600"><%= r.amount %></td>
              <td class="p-3 space-x-1 space-x-reverse">
                <% if(r.buyer_id_front) { %><a href="/admin/view-private/<%= r.buyer_id_front %>" target="_blank" class="bg-blue-100 text-blue-700 px-1.5 py-1 rounded text-xs font-bold" title="هوية المشتري">م</a><% } %>
                <% if(r.seller_id_front) { %><a href="/admin/view-private/<%= r.seller_id_front %>" target="_blank" class="bg-purple-100 text-purple-700 px-1.5 py-1 rounded text-xs font-bold" title="هوية البائع">ب</a><% } %>
              </td>
              <td class="p-3">
                <% if(r.tracking_status === 'waiting_payment') { %><span class="bg-amber-100 text-amber-700 px-2 py-1 rounded text-xs font-bold">بانتظار الدفع</span>
                <% } else if(r.tracking_status === 'funds_held') { %><span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs font-bold">أموال محجوزة</span>
                <% } else if(r.tracking_status === 'shipped') { %><span class="bg-purple-100 text-purple-700 px-2 py-1 rounded text-xs font-bold">تم الشحن</span>
                <% } else { %><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">مكتمل</span><% } %>
              </td>
              <td class="p-3 flex gap-1 flex-wrap">
                <% if(r.tracking_status === 'waiting_payment') { %>
                  <form action="/admin/shield/update-status/<%= r.id %>" method="POST"><input type="hidden" name="status" value="funds_held"><button class="bg-blue-500 text-white px-2 py-1 rounded text-xs font-bold">تأكيد الدفع</button></form>
                <% } else if(r.tracking_status === 'funds_held') { %>
                  <a href="/certificate-shield/<%= r.id %>" target="_blank" class="bg-cyan-500 text-white px-2 py-1 rounded text-xs font-bold">الشهادة</a>
                  <form action="/admin/shield/update-status/<%= r.id %>" method="POST"><input type="hidden" name="status" value="shipped"><button class="bg-purple-500 text-white px-2 py-1 rounded text-xs font-bold">تم الشحن</button></form>
                <% } else if(r.tracking_status === 'shipped') { %>
                  <form action="/admin/shield/update-status/<%= r.id %>" method="POST"><input type="hidden" name="status" value="completed"><button class="bg-green-500 text-white px-2 py-1 rounded text-xs font-bold">تم التسليم</button></form>
                <% } %>
                <% if(r.buyer_id_front || r.seller_id_front) { %>
                  <form action="/admin/shield/delete-ids/<%= r.id %>" method="POST" onsubmit="return confirm('حذف الهويات نهائياً؟')"><button class="bg-red-500 text-white px-2 py-1 rounded text-xs font-bold"><i class="fa-solid fa-trash"></i></button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
