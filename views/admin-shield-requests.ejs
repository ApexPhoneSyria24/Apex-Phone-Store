<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"><title>درع التحقق</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 p-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-black text-slate-800"><i class="fa-solid fa-shield-halved text-cyan-600"></i> طلبات التحقق (Apex Shield)</h1>
      <a href="/admin" class="bg-slate-800 text-white px-4 py-2 rounded-lg font-bold">عودة للإدارة</a>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border overflow-x-auto">
      <table class="w-full text-right text-sm whitespace-nowrap">
        <thead class="bg-slate-100 text-slate-600">
          <tr>
            <th class="p-3">#</th>
            <th class="p-3">المشتري</th>
            <th class="p-3">البائع</th>
            <th class="p-3">المبلغ</th>
            <th class="p-3">رقم العملية</th>
            <th class="p-3">الإشعار</th>
            <th class="p-3">الحالة</th>
            <th class="p-3">إجراءات</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% requests.forEach(r => { %>
            <tr class="hover:bg-slate-50">
              <td class="p-3 text-slate-500"><%= r.id %></td>
              <td class="p-3 font-bold" dir="ltr"><%= r.buyer_phone %></td>
              <td class="p-3 font-bold" dir="ltr"><%= r.seller_phone %></td>
              <td class="p-3 font-bold text-green-600"><%= r.amount %></td>
              <td class="p-3 text-xs font-mono"><%= r.tx_id || '-' %></td>
              <td class="p-3"><% if(r.receipt_image) { %><a href="<%= r.receipt_image %>" target="_blank" class="text-blue-500 font-bold text-xs"><i class="fa-solid fa-image"></i> عرض</a><% } else { %>-<% } %></td>
              <td class="p-3">
                <% if(r.status === 'approved') { %><span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">موافق</span>
                <% } else if(r.status === 'rejected') { %><span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold">مرفوض</span>
                <% } else { %><span class="bg-amber-100 text-amber-700 px-2 py-1 rounded text-xs font-bold">معلق</span><% } %>
              </td>
              <td class="p-3 flex gap-1">
                <% if(r.status === 'pending') { %>
                  <form action="/admin/shield/approve/<%= r.id %>" method="POST"><button class="bg-green-100 text-green-700 px-2 py-1 rounded font-bold hover:bg-green-200"><i class="fa-solid fa-check"></i></button></form>
                  <form action="/admin/shield/reject/<%= r.id %>" method="POST"><button class="bg-red-100 text-red-700 px-2 py-1 rounded font-bold hover:bg-red-200"><i class="fa-solid fa-xmark"></i></button></form>
                <% } else if(r.status === 'approved') { %>
                  <a href="/certificate-shield/<%= r.id %>" target="_blank" class="bg-cyan-100 text-cyan-700 px-2 py-1 rounded font-bold hover:bg-cyan-200 text-xs"><i class="fa-solid fa-certificate"></i> الشهادة</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if(requests.length === 0) { %><tr><td colspan="8" class="p-6 text-center text-slate-500 font-bold">لا توجد طلبات.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
