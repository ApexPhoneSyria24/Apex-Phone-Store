
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title>طلبات الشحن</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body class="bg-slate-50 min-h-screen p-4">
<nav class="bg-white shadow-sm border-b mb-6"><div class="max-w-7xl mx-auto px-4 h-14 flex justify-between items-center"><h1 class="font-bold text-lg">طلبات الشحن</h1><a href="/admin" class="bg-slate-100 px-4 py-2 rounded-lg font-bold text-sm">عودة</a></div></nav>
<div class="max-w-7xl mx-auto space-y-4">
  <% if(orders.length === 0) { %><p class="text-slate-500 font-bold">لا توجد طلبات.</p><% } %>
  <% orders.forEach(o => { %>
    <div class="bg-white p-6 rounded-xl shadow-sm border flex flex-col md:flex-row justify-between items-start md:items-center gap-4 <%= o.status === 'pending' ? 'border-amber-300' : '' %>">
      <div>
        <h3 class="text-lg font-bold"><%= o.game_name %> - <%= o.package_name %></h3>
        <p class="text-sm text-slate-600 mt-1">ID: <span class="font-bold text-slate-800"><%= o.player_id %></span></p>
        <p class="text-sm text-slate-600">هاتف: <span class="font-bold text-slate-800"><%= o.user_phone %></span></p>
        <p class="text-xs text-slate-400 mt-2"><%= new Date(o.created_at).toLocaleString('ar-EG') %></p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <span class="text-xl font-black text-slate-900">$<%= o.price %></span>
        <% if(o.status === 'pending') { %>
          <div class="flex flex-col md:flex-row gap-2 mt-2 w-full">
            <form action="/admin/topups/approve/<%= o.id %>" method="POST" class="w-full">
              <button class="bg-green-500 text-white px-4 py-2 rounded-lg font-bold w-full">موافقة (شحن)</button>
            </form>
            <form action="/admin/topups/reject/<%= o.id %>" method="POST" class="flex items-center gap-2 w-full">
              <input type="text" name="reason" placeholder="سبب الرفض" required class="border p-2 rounded-lg text-sm w-full">
              <button class="bg-red-500 text-white px-4 py-2 rounded-lg font-bold whitespace-nowrap">رفض</button>
            </form>
          </div>
        <% } else if(o.status === 'approved') { %>
          <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full font-bold text-sm">تم الشحن</span>
        <% } else { %>
          <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full font-bold text-sm">مرفوض</span>
          <p class="text-xs text-red-600 mt-1">السبب: <%= o.rejection_reason %></p>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>
<script src="/tracker.js"></script>
</body>
</html>
