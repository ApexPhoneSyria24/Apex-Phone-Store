<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لوحة الإدارة | Apex فون</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    

  
  

  
  <!-- admin/visits-click -->
  

<script>
  document.addEventListener('click', function(e) {
    // إذا تم النقر على أي عنصر يحتوي على كلمة "إحصائيات الزوار"
    if (e.target && e.target.textContent && e.target.textContent.includes('إحصائيات الزوار')) {
      window.location.href = '/admin/visits';
    }
  });
</script>


  <script>
  // CLICK_JS
  document.addEventListener('click', function(e) {
    let el = e.target;
    while (el) {
      if (el.textContent && el.textContent.trim().includes('إحصائيات الزوار')) {
        window.location.href = '/admin/visits';
        return;
      }
      el = el.parentElement;
    }
  });
  </script>
  
</body>
</html>
