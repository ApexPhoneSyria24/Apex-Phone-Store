<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة الإدارة | Apex فون</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
</head>
<body class="bg-slate-100 font-sans min-h-screen">
  
  <!-- الشريط العلوي -->
  <div class="bg-slate-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
      <h1 class="font-black text-xl"><i class="fa-solid fa-shield-halved text-cyan-400"></i> لوحة الإدارة</h1>
      <div class="flex gap-2">
        <a href="/" class="bg-slate-700 hover:bg-slate-600 px-3 py-2 rounded-lg font-bold text-xs transition"><i class="fa-solid fa-store"></i> المتجر</a>
        <a href="/admin/logout" class="bg-red-600 hover:bg-red-700 px-3 py-2 rounded-lg font-bold text-xs transition"><i class="fa-solid fa-right-from-bracket"></i> خروج</a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto p-4 md:p-6">
    
    <!-- شريط الأزرار السريعة مع شارات التنبيه -->
    <div class="flex flex-wrap gap-3 mb-6">
      <!-- إحصائيات الزوار -->
      <a href="/admin/visits" class="relative bg-cyan-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-cyan-700 transition"><i class="fa-solid fa-chart-line"></i> إحصائيات الزوار</a>
      
      <!-- إدارة الألعاب -->
      <a href="/admin/games" class="relative bg-indigo-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-indigo-700 transition"><i class="fa-solid fa-gamepad"></i> إدارة الألعاب</a>
      
      <!-- إيداعات الرصيد -->
      <a href="/admin/deposits" class="relative bg-purple-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-purple-700 transition">
        <i class="fa-solid fa-money-bill-transfer"></i> إيداعات الرصيد
        <% if (stats.pendingDepositsCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-black px-2 py-0.5 rounded-full shadow-md animate-pulse"><%= stats.pendingDepositsCount %></span>
        <% } %>
      </a>

      <!-- طلبات الشحن -->
      <a href="/admin/topups" class="relative bg-green-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-green-700 transition">
        <i class="fa-solid fa-bolt"></i> طلبات الشحن
        <% if (stats.topupsCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-black px-2 py-0.5 rounded-full shadow-md animate-pulse"><%= stats.topupsCount %></span>
        <% } %>
      </a>

      <!-- الإعلانات المعلقة -->
      <a href="/admin/pending" class="relative bg-amber-500 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-amber-600 transition">
        <i class="fa-solid fa-clock"></i> الإعلانات المعلقة
        <% if (stats.pendingCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-black px-2 py-0.5 rounded-full shadow-md animate-pulse"><%= stats.pendingCount %></span>
        <% } %>
      </a>

      <!-- طلبات التوثيق -->
      <a href="/admin/verifications" class="relative bg-blue-500 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-blue-600 transition">
        <i class="fa-solid fa-id-card"></i> طلبات التوثيق
        <% if (stats.verificationsCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-black px-2 py-0.5 rounded-full shadow-md animate-pulse"><%= stats.verificationsCount %></span>
        <% } %>
      </a>

      <!-- التقييمات -->
      <a href="/admin/reviews" class="relative bg-pink-500 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-pink-600 transition">
        <i class="fa-solid fa-star"></i> التقييمات
        <% if (stats.reviewsCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-black px-2 py-0.5 rounded-full shadow-md animate-pulse"><%= stats.reviewsCount %></span>
        <% } %>
      </a>

      <!-- المستخدمون -->
      <a href="/admin/users" class="relative bg-slate-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-slate-700 transition"><i class="fa-solid fa-users"></i> المستخدمون</a>
      
      <!-- البانرات -->
      <a href="/admin/banners" class="relative bg-slate-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-slate-700 transition"><i class="fa-solid fa-images"></i> البانرات</a>
    </div>

    <!-- بطاقات الإحصائيات -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-blue-500">
        <div class="text-sm font-bold text-slate-500 mb-1">إعلانات المتجر</div>
        <div class="text-2xl font-black text-blue-600"><%= stats.adminPhonesCount %></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-green-500">
        <div class="text-sm font-bold text-slate-500 mb-1">إعلانات الزبائن</div>
        <div class="text-2xl font-black text-green-600"><%= stats.userAdsCount %></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-amber-500">
        <div class="text-sm font-bold text-slate-500 mb-1">إعلانات معلقة</div>
        <div class="text-2xl font-black text-amber-500"><%= stats.pendingCount %></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-purple-500">
        <div class="text-sm font-bold text-slate-500 mb-1">طلبات الشحن</div>
        <div class="text-2xl font-black text-purple-600"><%= stats.topupsCount %></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border-r-4 border-teal-500">
        <div class="text-sm font-bold text-slate-500 mb-1">إيداعات الرصيد</div>
        <div class="text-2xl font-black text-teal-600"><%= stats.pendingDepositsCount || 0 %></div>
      </div>
    </div>

    <!-- جدول إدارة الهواتف -->
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
      <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
        <h2 class="font-bold text-slate-800"><i class="fa-solid fa-mobile-screen text-cyan-600"></i> إدارة الهواتف (آخر 100 إعلان)</h2>
        <a href="/admin/add" class="bg-cyan-600 text-white px-4 py-2 rounded-lg font-bold text-sm shadow hover:bg-cyan-700 transition"><i class="fa-solid fa-plus"></i> إضافة هاتف</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right text-sm">
          <thead class="bg-slate-100 text-slate-600">
            <tr>
              <th class="p-3">#</th>
              <th class="p-3">الصورة</th>
              <th class="p-3">الاسم</th>
              <th class="p-3">الماركة</th>
              <th class="p-3">السعر</th>
              <th class="p-3">الإجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% phones.forEach(phone => { %>
              <tr class="hover:bg-slate-50">
                <td class="p-3 text-slate-500"><%= phone.id %></td>
                <td class="p-3">
                  <% 
                    let img = 'https://placehold.co/50x50/e2e8f0/64748b?text=No+Img'; 
                    try { 
                      let imgs = JSON.parse(phone.images || '[]'); 
                      if(imgs && imgs.length > 0) img = imgs[0]; 
                    } catch(e){} 
                  %>
                  <img src="<%= img %>" class="w-12 h-12 object-cover rounded-lg border border-slate-200 shadow-sm" onerror="this.src='https://placehold.co/50x50/e2e8f0/64748b?text=Error'">
                </td>
                <td class="p-3 font-bold text-slate-800"><%= phone.name %></td>
                <td class="p-3 text-slate-600 font-semibold"><%= phone.brand %></td>
                <td class="p-3 font-black text-green-600">$<%= phone.price %></td>
                <td class="p-3 flex gap-1">
                  <a href="/admin/edit/<%= phone.id %>" class="bg-blue-100 text-blue-700 p-2 rounded-lg hover:bg-blue-200 transition" title="تعديل"><i class="fa-solid fa-pen"></i></a>
                  <form action="/admin/feature/<%= phone.id %>" method="POST" class="inline">
                    <button class="bg-amber-100 text-amber-700 p-2 rounded-lg hover:bg-amber-200 transition" title="تمييز"><i class="fa-solid fa-star"></i></button>
                  </form>
                  <form action="/admin/delete/<%= phone.id %>" method="POST" class="inline" onsubmit="return confirm('هل أنت متأكد من الحذف؟')">
                    <button class="bg-red-100 text-red-700 p-2 rounded-lg hover:bg-red-200 transition" title="حذف"><i class="fa-solid fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if(phones.length === 0) { %>
              <tr><td colspan="6" class="p-6 text-center text-slate-500 font-bold">لا توجد هواتف مضافة.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</body>
</html>
