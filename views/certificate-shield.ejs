<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"><title>شهادة وساطة Apex</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Amiri:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #050505; background-image: radial-gradient(circle at 50% 0%, rgba(0, 243, 255, 0.15), transparent 60%); font-family: 'Tajawal', sans-serif; color: white; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; margin: 0; }
    .certificate-box { background: linear-gradient(135deg, #0f172a 0%, #050505 100%); border: 2px solid #00f3ff; border-radius: 20px; padding: 30px; width: 100%; max-width: 450px; position: relative; box-shadow: 0 0 40px rgba(0, 243, 255, 0.2); text-align: center; transition: 0.5s; }
    
    /* ألوان الشهادة الذهبية عند الإكمال */
    .certificate-box.completed { border-color: #BF953F; box-shadow: 0 0 40px rgba(191, 149, 63, 0.3); }
    
    .corner { position: absolute; width: 40px; height: 40px; border-color: #00f3ff; border-style: solid; }
    .certificate-box.completed .corner { border-color: #BF953F; }
    .corner-tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; border-top-left-radius: 10px; }
    .corner-tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; border-top-right-radius: 10px; }
    .corner-bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; border-bottom-left-radius: 10px; }
    .corner-br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; border-bottom-right-radius: 10px; }
    
    .cyan-text { color: #00f3ff; text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }
    .gold-text { color: #FCF6B5; text-shadow: 0 0 10px rgba(191, 149, 63, 0.5); }
    
    .seal { width: 100px; height: 100px; border-radius: 50%; border: 3px dashed #00f3ff; display: flex; align-items: center; justify-content: center; margin: 20px auto; background: rgba(0, 243, 255, 0.05); box-shadow: 0 0 20px rgba(0, 243, 255, 0.3); }
    .certificate-box.completed .seal { border-color: #BF953F; background: rgba(191, 149, 63, 0.1); box-shadow: 0 0 20px rgba(191, 149, 63, 0.4); }
    
    .watermark { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 80px; font-weight: 900; color: rgba(0,243,255,0.02); pointer-events: none; white-space: nowrap; font-family: 'Amiri', serif; }
    .certificate-box.completed .watermark { color: rgba(191,149,63,0.03); }
  </style>
</head>
<body>
  <% const isCompleted = request.tracking_status === 'completed'; %>
  <div class="certificate-box <%= isCompleted ? 'completed' : '' %>">
    <div class="corner corner-tl"></div><div class="corner corner-tr"></div><div class="corner corner-bl"></div><div class="corner corner-br"></div>
    <div class="watermark">APEX ESCROW</div>

    <div class="w-16 h-16 bg-gradient-to-br <%= isCompleted ? 'from-yellow-400 to-yellow-600' : 'from-cyan-400 to-blue-600' %> rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
      <i class="fa-solid <%= isCompleted ? 'fa-trophy text-yellow-900' : 'fa-handshake-angle text-white' %> text-3xl"></i>
    </div>

    <h1 class="text-2xl font-black <%= isCompleted ? 'gold-text' : 'cyan-text' %> mb-1">
      <%= isCompleted ? 'شهادة إتمام صفقة آمنة' : 'شهادة حجز أموال' %>
    </h1>
    <p class="text-xs text-slate-400 mb-6 font-bold tracking-widest">
      <%= isCompleted ? 'COMPLETED SECURE TRANSACTION' : 'OFFICIAL ESCROW CERTIFICATE' %>
    </p>

    <div class="bg-black/40 border border-slate-800 rounded-xl p-4 text-right space-y-3 mb-6">
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400 text-sm">الطرف الأول (المشتري):</span>
        <span class="font-bold text-white text-sm" dir="ltr"><%= request.buyer_phone %></span>
      </div>
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400 text-sm">الطرف الثاني (البائع):</span>
        <span class="font-bold text-white text-sm" dir="ltr"><%= request.seller_phone %></span>
      </div>
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400 text-sm"><%= isCompleted ? 'المبلغ المدفوع:' : 'المبلغ المحجوز:' %></span>
        <span class="font-bold <%= isCompleted ? 'text-yellow-400' : 'text-green-400' %> text-sm"><%= request.amount %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400 text-sm">رقم الشهادة:</span>
        <span class="font-bold text-white text-xs font-mono">APX-ESCROW-<%= request.id %>00<%= request.id %></span>
      </div>
    </div>

    <div class="seal">
      <div class="text-center">
        <i class="fa-solid <%= isCompleted ? 'fa-check-double text-yellow-500' : 'fa-lock text-cyan-400' %> text-3xl mb-1"></i>
        <p class="text-[10px] font-black leading-tight <%= isCompleted ? 'text-yellow-500' : 'text-cyan-400' %>">
          <%= isCompleted ? 'تمت الصفقة بنجاح<br>APEX ESCROW' : 'وسيط معتمد<br>APEX ESCROW' %>
        </p>
      </div>
    </div>

    <p class="text-[11px] text-slate-400 leading-relaxed mt-4">
      <% if (isCompleted) { %>
        تشهد إدارة <b>Apex Phone Syria</b> بأن هذه الصفقة قد اكتملت بنجاح تام. تم تسليم المنتج للمشتري، وتم تحويل المبلغ للبائع. هذه الوثيقة تعتبر إيصالاً رسمياً للطرفين.
      <% } else { %>
        تشهد إدارة <b>Apex Phone Syria</b> بأنها استلمت رسوم الوساطة من الطرفين، واستلمت مبلغ الهاتف من المشتري. تتعهد الإدارة بتسليم مبلغ الهاتف للبائع فور تأكيد استلام المنتج.
      <% } %>
    </p>

    <button onclick="window.print()" class="mt-6 w-full bg-slate-800 border border-slate-700 text-white font-bold py-2.5 rounded-xl hover:bg-slate-700 transition text-sm flex items-center justify-center gap-2">
      <i class="fa-solid fa-print"></i> طباعة / حفظ PDF
    </button>
  </div>
</body>
</html>
