<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= phone.name %> - السعر والمواصفات | Apex فون</title>

<!-- وسوم السيو لواتساب وفيسبوك (Open Graph) -->
<meta property="og:title" content="<%= phone.name %> متوفر الآن بسعر $<%= phone.price %> | Apex فون">
<meta property="og:description" content="<%= phone.description || 'أفضل الأسعار وأجهزة أصلية بضمان محلي.' %>">
<meta property="og:image" content="<%= (JSON.parse(phone.images || '[]'))[0] || '' %>">
<meta property="og:type" content="product">

<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Almarai', 'sans-serif'] }, colors: { brand: { 500: '#2563eb', 600: '#1d4ed8' } } } } }</script>
<style>
  .spec-row:nth-child(even) { background-color: #f8fafc; }
  .swiper-pagination-bullet-active { background: #2563eb !important; }
  #lightbox { background: rgba(0,0,0,0.95); backdrop-filter: blur(5px); transition: opacity 0.3s; }
  #lightbox img { max-width: 95vw; max-height: 95vh; object-fit: contain; transition: transform 0.3s; }
</style>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1BPM70EPWG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-1BPM70EPWG');
</script>
</head>
<body class="font-sans bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-3 h-12 flex items-center justify-between">
    <a href="/" class="flex items-center gap-1 text-slate-600 hover:text-brand-600 font-bold transition text-xs"><i class="fa-solid fa-arrow-right"></i> العودة</a>
    <div class="text-sm font-extrabold text-slate-900">Apex فون</div>
  </div>
</nav>

<main class="flex-1 w-full max-w-4xl mx-auto px-3 py-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white rounded-xl shadow-sm overflow-hidden border border-slate-100 p-3">
    
    <!-- معرض الصور مع ميزة التكبير -->
    <div class="w-full">
      <div class="swiper mySwiper w-full h-[200px] md:h-[280px] bg-slate-50 rounded-lg overflow-hidden border border-slate-100">
        <div class="swiper-wrapper">
          <% 
            let imgs = []; try { imgs = JSON.parse(phone.images || '[]'); } catch(e) {}
            if (imgs.length === 0) imgs = ['https://via.placeholder.com/600x600?text=No+Image'];
            imgs.forEach(img => {
          %>
            <div class="swiper-slide flex items-center justify-center p-3 cursor-zoom-in" onclick="openLightbox('<%= img %>')">
              <img src="https://images.weserv.nl/?url=https://apexphonesyria.online<%= img %>&w=800&output=webp&q=80" class="w-full h-full object-contain" alt="<%= phone.name %>">
            </div>
          <% }) %>
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

    <!-- التفاصيل -->
    <div class="flex flex-col justify-center">
      <div class="flex gap-2 mb-2 items-center flex-wrap">
        <div class="text-[10px] font-extrabold text-brand-600 bg-brand-50 inline-block px-2 py-0.5 rounded"><%= phone.brand %></div>
        <% if (phone.is_admin === 1) { %>
          <div class="text-[9px] font-extrabold text-white bg-blue-600 px-2 py-0.5 rounded flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> الإدارة</div>
        <% } else if (isVerified) { %>
          <div class="text-[9px] font-extrabold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded flex items-center gap-1">
    <svg class="w-3 h-3 inline-block" viewBox="0 0 24 24" fill="currentColor"><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"></path></svg>
    بائع موثوق
</div>
        <% } else { %>
          
        <% } %>
      </div>
      
      <h1 class="text-lg md:text-xl font-extrabold text-slate-900 mb-2 leading-tight"><%= phone.name %></h1>
      <div class="text-2xl font-extrabold text-slate-900 mb-3 flex items-end gap-1">$<%= phone.price %> <span class="text-[10px] text-slate-400 font-bold mb-1">/ شامل الضريبة</span></div>
      
      <div class="mb-3">
        <% if (phone.availability === 'متوفر') { %>
          <span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 font-extrabold px-2.5 py-1 rounded text-[10px]"><span class="animate-ping absolute inline-flex h-1.5 w-1.5 rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span> متوفر</span>
        <% } else { %>
          <span class="inline-flex items-center gap-1.5 bg-slate-200 text-slate-600 font-extrabold px-2.5 py-1 rounded text-[10px]"><i class="fa-solid fa-ban"></i> تم البيع</span>
        <% } %>
      </div>

      <p class="text-slate-600 text-xs leading-relaxed mb-4"><%= phone.description || 'لا يوجد وصف.' %></p>

      <% if (phone.is_admin === 1) { %>
        <a href="https://wa.me/963980259127?text=مرحباً،%20أريد%20الاستفسار%20عن%20هاتف%20<%= encodeURIComponent(phone.name) %>" target="_blank" class="w-full bg-green-500 text-white text-center py-2 rounded-lg font-extrabold text-sm mb-2"><i class="fa-brands fa-whatsapp text-lg mr-1"></i> تواصل للشراء</a>
      <% } else { %>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2 text-center">
          <p class="text-[9px] text-amber-800 font-bold mb-1">هذا إعلان مستخدم. نحن الوسيط الآمن.</p>
          <a href="https://wa.me/963980259127?text=مرحباً،%20أريد%20الاستفسار%20عن%20هاتف%20<%= encodeURIComponent(phone.name) %>" target="_blank" class="w-full bg-amber-500 text-white text-center py-1.5 rounded-lg font-extrabold text-xs block"><i class="fa-solid fa-headset"></i> تواصل مع الإدارة</a>
        </div>
      <% } %>

      <div class="flex items-center gap-1.5 pt-2 border-t border-slate-100">
        <span class="text-[10px] font-bold text-slate-500">شارك:</span>
        <a href="https://wa.me/?text=شاهد%20هذا%20الهاتف:%20<%= encodeURIComponent(phone.name) %>%20-%20http://localhost:3000/phone/<%= phone.id %>" target="_blank" class="w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center hover:bg-green-200 transition text-xs"><i class="fa-brands fa-whatsapp"></i></a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=http://localhost:3000/phone/<%= phone.id %>" target="_blank" class="w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center hover:bg-blue-200 transition text-xs"><i class="fa-brands fa-facebook-f"></i></a>
      </div>
    </div>
  </div>

  <!-- المواصفات -->
  <div class="mt-4 bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-900 px-3 py-2"><h2 class="text-sm font-extrabold text-white flex items-center gap-1.5"><i class="fa-solid fa-microchip text-brand-500"></i> المواصفات التقنية</h2></div>
    <div class="divide-y divide-slate-100">
      <% 
        const specs = [
          { label: 'المعالج', value: phone.cpu, icon: 'fa-microchip' }, { label: 'الذاكرة (RAM)', value: phone.ram, icon: 'fa-memory' },
          { label: 'التخزين', value: phone.storage, icon: 'fa-hard-drive' }, { label: 'الشاشة', value: phone.screen, icon: 'fa-mobile-screen' },
          { label: 'الكاميرا', value: phone.camera, icon: 'fa-camera' }, { label: 'البطارية', value: phone.battery, icon: 'fa-battery-full' },
        ].filter(s => s.value);
        if (specs.length === 0) {
      %><div class="p-3 text-center text-slate-500 font-bold text-xs">لم يتم إضافة مواصفات.</div><% } else { specs.forEach(s => { %>
        <div class="spec-row flex items-center justify-between p-2 md:px-4 hover:bg-brand-50/30 transition">
          <div class="flex items-center gap-2 text-slate-700 font-bold text-xs"><div class="w-6 h-6 bg-brand-50 text-brand-600 rounded flex items-center justify-center text-[10px]"><i class="fa-solid <%= s.icon %>"></i></div><%= s.label %></div>
          <div class="text-slate-900 font-extrabold text-xs text-left"><%= s.value %></div>
        </div>
      <% }) } %>
    </div>
  </div>

  <!-- قسم التقييمات -->
  <div class="mt-4 bg-white rounded-xl shadow-sm border border-slate-200 p-4">
    <h2 class="text-sm font-extrabold text-slate-900 mb-3 border-b pb-2"><i class="fa-solid fa-star text-amber-400"></i> آراء وتقييمات الزبائن (<%= reviews.length %>)</h2>
    
    <% if (reviews.length === 0) { %>
      <p class="text-[10px] text-slate-500 font-bold text-center">لا توجد تقييمات بعد. كن أول من يقيّم!</p>
    <% } else { %>
      <div class="space-y-3 mb-6">
        <% reviews.forEach(r => { %>
          <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-bold text-slate-800"><%= r.reviewer_name %></span>
              <div class="text-amber-400 text-[9px]">
                <% for(let i=1; i<=5; i++) { %><i class="fa-solid fa-star <%= i <= r.rating ? '' : 'text-slate-300' %>"></i><% } %>
              </div>
            </div>
            <p class="text-[10px] text-slate-600 font-bold"><%= r.comment %></p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <form action="/phone/<%= phone.id %>/review" method="POST" class="bg-slate-50 p-3 rounded-lg border border-slate-200">
      <h3 class="text-xs font-extrabold text-slate-800 mb-2">أضف تقييمك</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-2">
        <input type="text" name="reviewer_name" required placeholder="اسمك" class="px-2 py-1.5 rounded border border-slate-300 text-xs w-full">
        <select name="rating" required class="px-2 py-1.5 rounded border border-slate-300 text-xs w-full font-bold">
          <option value="5">⭐⭐⭐⭐⭐ ممتاز</option>
          <option value="4">⭐⭐⭐⭐ جيد جداً</option>
          <option value="3">⭐⭐⭐ جيد</option>
          <option value="2">⭐⭐ مقبول</option>
          <option value="1">⭐ ضعيف</option>
        </select>
      </div>
      <textarea name="comment" rows="2" placeholder="اكتب تجربتك..." class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs mb-2"></textarea>
      <button type="submit" class="bg-slate-900 text-white px-4 py-1.5 rounded-lg text-xs font-bold hover:bg-black transition">إرسال التقييم</button>
    </form>
  </div>
</main>

<!-- نافذة تكبير الصور -->
<div id="lightbox" class="fixed inset-0 z-[20000] hidden flex items-center justify-center opacity-0">
  <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white text-4xl hover:text-red-500 transition z-50">&times;</button>
  <img id="lightbox-img" src="" alt="Zoomed Image">
</div>

<footer class="text-center py-3 text-slate-500 font-bold text-[10px] flex items-center justify-center gap-1.5 flex-wrap mt-auto">
  © 2026 Apex فون <span class="inline-flex items-center gap-1 bg-green-500/10 text-green-600 px-1.5 py-0.5 rounded border border-green-500/20"><i class="fa-solid fa-lock text-[8px]"></i> آمن</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  new Swiper(".mySwiper", { pagination: { el: ".swiper-pagination", clickable: true }, loop: true, autoplay: { delay: 3000 } });

  function openLightbox(src) {
    const lb = document.getElementById('lightbox');
    document.getElementById('lightbox-img').src = src;
    lb.classList.remove('hidden');
    setTimeout(() => lb.classList.add('opacity-100'), 10);
  }
  function closeLightbox() {
    const lb = document.getElementById('lightbox');
    lb.classList.remove('opacity-100');
    setTimeout(() => lb.classList.add('hidden'), 300);
  }
</script>
<script src="/tracker.js"></script>
</body>
</html>
