<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تعديل هاتف</title>
<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Almarai', 'sans-serif'] }, colors: { brand: { 500: '#2563eb', 600: '#1d4ed8' } } } } }</script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1BPM70EPWG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-1BPM70EPWG');
</script>
</head>
<body class="font-sans bg-slate-50 text-slate-800 antialiased min-h-screen p-3">
  <div class="w-full max-w-xl mx-auto bg-white rounded-xl shadow-md p-4 md:p-6 border border-slate-100 my-4">
    <h2 class="text-lg font-extrabold text-slate-900 mb-3 text-center">تعديل البيانات</h2>
    
    <form action="/admin/edit/<%= phone.id %>" method="POST" enctype="multipart/form-data" class="space-y-3">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div><label class="block text-[10px] font-bold text-slate-700 mb-1">اسم الهاتف</label><input type="text" name="name" value="<%= phone.name %>" required class="w-full px-2.5 py-1.5 rounded border border-slate-200 outline-none bg-slate-50 text-xs"></div>
        <div><label class="block text-[10px] font-bold text-slate-700 mb-1">الماركة</label><input type="text" name="brand" value="<%= phone.brand %>" required class="w-full px-2.5 py-1.5 rounded border border-slate-200 outline-none bg-slate-50 text-xs"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div><label class="block text-[10px] font-bold text-slate-700 mb-1">السعر ($)</label><input type="number" step="0.01" name="price" value="<%= phone.price %>" required class="w-full px-2.5 py-1.5 rounded border border-slate-200 outline-none bg-slate-50 text-xs"></div>
        <div>
          <label class="block text-[10px] font-bold text-slate-700 mb-1">التوفر</label>
          <select name="availability" class="w-full px-2.5 py-1.5 rounded border border-slate-200 outline-none bg-slate-50 text-xs font-bold">
            <option value="متوفر" <%= phone.availability === 'متوفر' ? 'selected' : '' %>>🟢 متوفر</option>
            <option value="غير متوفر" <%= phone.availability === 'غير متوفر' ? 'selected' : '' %>>🔴 غير متوفر</option>
          </select>
        </div>
      </div>

      <div class="bg-slate-50 rounded-lg p-3 border border-slate-200">
        <h3 class="text-xs font-extrabold text-slate-800 mb-2">المواصفات</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <input type="text" name="cpu" value="<%= phone.cpu || '' %>" placeholder="المعالج" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
          <input type="text" name="ram" value="<%= phone.ram || '' %>" placeholder="الرام" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
          <input type="text" name="storage" value="<%= phone.storage || '' %>" placeholder="التخزين" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
          <input type="text" name="screen" value="<%= phone.screen || '' %>" placeholder="الشاشة" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
          <input type="text" name="camera" value="<%= phone.camera || '' %>" placeholder="الكاميرا" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
          <input type="text" name="battery" value="<%= phone.battery || '' %>" placeholder="البطارية" class="w-full px-2 py-1.5 rounded border border-slate-200 outline-none bg-white text-xs">
        </div>
      </div>

      <div class="border-2 border-dashed border-amber-300 rounded-lg p-2 text-center bg-amber-50 relative">
        <input type="file" name="images" multiple accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <p class="text-[10px] font-bold text-amber-700">لتغيير الصور اضغط هنا (اتركه فارغاً للإبقاء على الحالية)</p>
      </div>

      <div>
        <label class="block text-[10px] font-bold text-slate-700 mb-1">الوصف</label>
        <textarea name="description" rows="2" class="w-full px-2.5 py-1.5 rounded border border-slate-200 outline-none bg-slate-50 text-xs"><%= phone.description || '' %></textarea>
      </div>

      <div class="flex gap-2 pt-2">
        <button type="submit" class="flex-1 bg-amber-500 hover:bg-amber-600 text-white py-2 rounded-lg font-extrabold text-xs shadow-sm transition">تحديث</button>
        <a href="/admin" class="px-4 py-2 rounded-lg font-bold text-slate-600 bg-slate-200 hover:bg-slate-300 transition text-xs">إلغاء</a>
      </div>
    </form>
  </div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fileInputs = document.querySelectorAll('input[type="file"][name="images"]');
    fileInputs.forEach(input => {
      const previewContainer = document.createElement('div');
      previewContainer.className = 'grid grid-cols-4 gap-2 mt-3';
      input.parentElement.after(previewContainer);

      input.addEventListener('change', function(event) {
        previewContainer.innerHTML = '';
        const files = event.target.files;

        for (let i = 0; i < files.length; i++) {
          if (files[i].type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
              const imgWrap = document.createElement('div');
              imgWrap.className = 'relative aspect-square rounded-lg overflow-hidden border border-slate-200 shadow-sm';
              imgWrap.innerHTML = '<img src="' + e.target.result + '" class="w-full h-full object-cover">';
              previewContainer.appendChild(imgWrap);
            }
            reader.readAsDataURL(files[i]);
          }
        }
      });
    });
  });
</script>

</body>
</html>
