
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><title>شحن <%= game.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] }, colors: { neon: { blue: '#00f3ff' } } } } }</script>
<style> body { background-color: #050505; color: white; background-image: radial-gradient(circle at 50% 0%, rgba(0,243,255,0.1), transparent 50%); } </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
<nav class="bg-black/50 backdrop-blur-md border-b border-cyan-500/20 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
    <a href="/games" class="flex items-center gap-2"><i class="fa-solid fa-arrow-right text-cyan-400"></i> <span class="font-bold">العودة للألعاب</span></a>
  </div>
</nav>
<div class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    
    <div>
      <div class="relative rounded-3xl overflow-hidden mb-8 border border-cyan-500/30 h-64">
        <img src="<%= game.image_url || 'https://via.placeholder.com/600x300?text=' + game.name %>" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
          <h1 class="text-4xl font-black text-white neon-text"><%= game.name %></h1>
        </div>
      </div>
      
      <form id="orderForm" class="bg-slate-900/80 p-6 rounded-3xl border border-slate-800 shadow-2xl">
        <h2 class="text-2xl font-black text-white mb-6">إتمام الشحن</h2>
        
        <div class="mb-5">
          <label class="block text-sm font-bold text-slate-300 mb-2">معرف اللاعب (Player ID)</label>
          <input type="text" name="player_id" required class="w-full bg-black border border-slate-700 rounded-xl px-4 py-3 text-white focus:border-cyan-400 outline-none transition" placeholder="أدخل الـ ID الخاص بك">
        </div>

        <div class="mb-5">
          <label class="block text-sm font-bold text-slate-300 mb-2">اختر الباقة</label>
          <select name="package" id="packageSelect" required class="w-full bg-black border border-slate-700 rounded-xl px-4 py-3 text-white focus:border-cyan-400 outline-none transition">
            <% packages.forEach(pkg => { %>
              <option value="<%= pkg.id %>" data-name="<%= pkg.package_name %>" data-price="<%= pkg.price %>">
                <%= pkg.package_name %> - $<%= pkg.price %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-slate-300 mb-2">رقم هاتفك (لمتابعة الطلب)</label>
          <input type="tel" name="user_phone" id="userPhone" required class="w-full bg-black border border-slate-700 rounded-xl px-4 py-3 text-white focus:border-cyan-400 outline-none transition" placeholder="09xxxxxxxx" dir="ltr">
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black py-4 rounded-xl hover:shadow-[0_0_20px_rgba(0,243,255,0.4)] transition text-lg">تأكيد الطلب</button>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-black text-white mb-6 flex items-center gap-3">
        <i class="fa-solid fa-clock-rotate-left text-cyan-400"></i> سجل طلباتك
      </h2>
      <div id="orderHistory" class="space-y-4">
        <div class="text-center py-10 bg-slate-900/50 rounded-3xl border border-slate-800">
          <p class="text-slate-500 font-bold">جاري تحميل السجل...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const userPhone = localStorage.getItem('apex_user_phone');
  if (userPhone) {
    document.getElementById('userPhone').value = userPhone;
    loadHistory(userPhone);
  }

  document.getElementById('orderForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const phone = formData.get('user_phone');
    localStorage.setItem('apex_user_phone', phone);

    const select = document.getElementById('packageSelect');
    const selectedOpt = select.options[select.selectedIndex];
    
    const data = {
      player_id: formData.get('player_id'),
      package_name: selectedOpt.getAttribute('data-name'),
      price: selectedOpt.getAttribute('data-price'),
      user_phone: phone
    };

    const btn = this.querySelector('button');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإرسال...';

    const res = await fetch('/games/<%= encodeURIComponent(game.name) %>/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      btn.innerHTML = '✅ تم إرسال الطلب بنجاح';
      btn.classList.add('from-green-500', 'to-green-600');
      setTimeout(() => { btn.innerHTML = 'تأكيد الطلب'; btn.classList.remove('from-green-500', 'to-green-600'); }, 3000);
      this.reset();
      document.getElementById('userPhone').value = phone;
      loadHistory(phone);
    }
  });

  function loadHistory(phone) {
    const container = document.getElementById('orderHistory');
    fetch('/api/topup-orders/' + phone)
      .then(r => r.json())
      .then(orders => {
        if (orders.length === 0) {
          container.innerHTML = '<div class="text-center py-10 bg-slate-900/50 rounded-3xl border border-slate-800"><p class="text-slate-500 font-bold">لا توجد طلبات سابقة.</p></div>';
          return;
        }
        container.innerHTML = '';
        orders.forEach(o => {
          let statusColor = o.status === 'approved' ? 'text-green-400 bg-green-400/10 border-green-400/20' : 
                            o.status === 'rejected' ? 'text-red-400 bg-red-400/10 border-red-400/20' : 
                            'text-amber-400 bg-amber-400/10 border-amber-400/20';
          
          let statusText = o.status === 'approved' ? '✅ تم القبول' : 
                           o.status === 'rejected' ? '❌ مرفوض' : '⏳ قيد المراجعة';

          container.innerHTML += `
            <div class="bg-slate-900/80 rounded-2xl p-5 border border-slate-800 flex justify-between items-center">
              <div>
                <h4 class="text-lg font-bold text-white">${o.package_name}</h4>
                <p class="text-sm text-slate-400 mt-1">ID: ${o.player_id}</p>
                ${o.rejection_reason ? `<p class="text-xs text-red-400 mt-2 font-bold">السبب: ${o.rejection_reason}</p>` : ''}
              </div>
              <div class="text-right">
                <div class="text-xl font-black text-cyan-400 mb-2">$${o.price}</div>
                <span class="px-3 py-1 rounded-full border text-xs font-bold ${statusColor}">${statusText}</span>
              </div>
            </div>
          `;
        });
      });
  }
});
</script>
</body>
</html>
