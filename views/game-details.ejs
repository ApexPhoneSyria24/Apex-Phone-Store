<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= game.name %> | شحن | Apex فون</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Tajawal', 'sans-serif'] }, colors: { neon: { blue: '#00f3ff' } } } } }</script>
  <style>
    body { background-color: #050505; color: white; background-image: radial-gradient(circle at 50% 0%, rgba(0, 243, 255, 0.1), transparent 50%); }
    .neon-text { text-shadow: 0 0 8px rgba(0, 243, 255, 0.8), 0 0 15px rgba(0, 243, 255, 0.4); }
    
    /* إصلاح القائمة المنسدلة الملكية لتعمل على الهواتف */
    .royal-select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background-color: #0f172a !important;
      color: #fbbf24 !important;
      border: 1px solid rgba(251, 191, 36, 0.5);
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23fbbf24' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: left 0.75rem center;
      background-size: 1.2em;
      padding-right: 1rem;
      padding-left: 3rem;
      width: 100%;
    }
    .royal-select option {
      background-color: #0f172a !important;
      color: #fbbf24 !important;
      font-weight: bold;
      padding: 10px;
    }
  </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
  <nav class="bg-black/50 backdrop-blur-md border-b border-cyan-500/20 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-3 h-10 flex justify-between items-center">
      <a href="/games/list?type=games" class="flex items-center gap-1.5 text-xs font-bold text-cyan-300 hover:text-white transition">
        <i class="fa-solid fa-arrow-right"></i> العودة
      </a>
      <div class="flex items-center gap-2">
        <span id="balanceBadge" class="hidden text-[10px] font-black bg-green-500/20 border border-green-500/50 text-green-400 px-2 py-1 rounded" dir="ltr">$0.00</span>
        <a href="/topup-balance" class="text-[10px] bg-cyan-600 hover:bg-cyan-700 text-white font-bold px-2 py-1 rounded transition"><i class="fa-solid fa-wallet"></i> شحن الرصيد</a>
      </div>
    </div>
  </nav>

  <div class="relative h-32 md:h-48 overflow-hidden border-b border-cyan-500/30">
    <% if (game.banner_url) { %>
      <img src="<%= game.banner_url %>" alt="<%= game.name %>" class="w-full h-full object-cover">
    <% } else if (game.image_url) { %>
      <img src="<%= game.image_url %>" alt="<%= game.name %>" class="w-full h-full object-cover blur-sm scale-110">
    <% } else { %>
      <div class="w-full h-full bg-gradient-to-br from-cyan-900 via-blue-900 to-black"></div>
    <% } %>
    <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/50 to-transparent"></div>
    <div class="absolute bottom-2 right-4">
      <h1 class="text-xl md:text-2xl font-black text-white neon-text"><%= game.name_ar || game.name %></h1>
      <p class="text-[10px] text-cyan-300 font-bold"><%= game.name %></p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-2 py-4 flex-1 w-full">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-4">
      <% if (game.developer) { %>
        <div class="bg-slate-900/70 border border-slate-800 rounded-lg p-2 text-center">
          <div class="text-cyan-400 text-[10px] font-bold mb-0.5"><i class="fa-solid fa-building"></i> المطور</div>
          <div class="text-white text-xs font-bold"><%= game.developer %></div>
        </div>
      <% } %>
      <% if (game.delivery_time) { %>
        <div class="bg-slate-900/70 border border-slate-800 rounded-lg p-2 text-center">
          <div class="text-green-400 text-[10px] font-bold mb-0.5"><i class="fa-solid fa-bolt"></i> وقت التسليم</div>
          <div class="text-white text-xs font-bold"><%= game.delivery_time %></div>
        </div>
      <% } %>
      <% if (game.instructions) { %>
        <div class="bg-slate-900/70 border border-slate-800 rounded-lg p-2 text-center col-span-2">
          <div class="text-yellow-400 text-[10px] font-bold mb-0.5"><i class="fa-solid fa-circle-info"></i> طريقة الشحن</div>
          <div class="text-white text-[10px] font-bold"><%= game.instructions %></div>
        </div>
      <% } %>
    </div>

    <% if (game.description) { %>
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-3 mb-4">
        <h2 class="text-sm font-black text-white mb-1"><i class="fa-solid fa-align-right text-cyan-400"></i> الوصف</h2>
        <p class="text-slate-300 text-[11px] leading-relaxed"><%= game.description %></p>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div>
        <form id="orderForm" class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 shadow-2xl">
          <h2 class="text-base font-black text-white mb-3"><i class="fa-solid fa-bolt text-cyan-400"></i> إتمام الشحن</h2>

          <div class="mb-3">
            <label class="block text-[11px] font-bold text-slate-300 mb-1">معرف اللاعب (Player ID)</label>
            <input type="text" name="player_id" required class="w-full bg-black border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:border-cyan-400 outline-none transition" placeholder="أدخل الـ ID الخاص بك">
          </div>

          <div class="mb-3">
            <label class="block text-[11px] font-bold text-amber-400 mb-1.5 flex items-center gap-1">
              <i class="fa-solid fa-crown"></i> اختر الباقة
            </label>
            <% if (samacardPackages && samacardPackages.length > 0) { %>
              <div class="relative">
                <select id="packageSelect" onchange="updateSelectedPackage(this)" class="royal-select rounded-lg py-2 text-xs font-bold outline-none cursor-pointer transition-all">
                  <% samacardPackages.forEach((pkg, index) => { %>
                    <option value="<%= pkg.id %>" data-name="<%= pkg.name %>" data-price="<%= pkg.price %>" <%= index === 0 ? 'selected' : '' %>>
                      <%= pkg.name %> - $<%= pkg.price %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <input type="hidden" id="selectedProductId" value="<%= samacardPackages[0].id %>">
              <input type="hidden" id="selectedPackageName" value="<%= samacardPackages[0].name %>">
              <input type="hidden" id="selectedPrice" value="<%= samacardPackages[0].price %>">
              <input type="hidden" id="isSamacard" value="true">
            <% } else if (packages.length > 0) { %>
              <div class="relative">
                <select id="packageSelect" onchange="updateSelectedPackage(this)" class="royal-select rounded-lg py-2 text-xs font-bold outline-none cursor-pointer transition-all">
                  <% packages.forEach((pkg, index) => { %>
                    <option value="<%= pkg.id %>" data-name="<%= pkg.package_name %>" data-price="<%= pkg.price %>" <%= index === 0 ? 'selected' : '' %>>
                      <%= pkg.package_name %> - $<%= pkg.price %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <input type="hidden" id="selectedProductId" value="<%= packages[0].id %>">
              <input type="hidden" id="selectedPackageName" value="<%= packages[0].package_name %>">
              <input type="hidden" id="selectedPrice" value="<%= packages[0].price %>">
              <input type="hidden" id="isSamacard" value="false">
            <% } else { %>
              <div class="text-center py-3 bg-slate-800 rounded-lg text-slate-400 text-[11px] font-bold border border-slate-700">لا توجد باقات متاحة حالياً</div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="block text-[11px] font-bold text-slate-300 mb-1">رقم هاتفك (لمتابعة الطلب)</label>
            <input type="tel" name="user_phone" id="userPhone" required class="w-full bg-black border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:border-cyan-400 outline-none transition" placeholder="09xxxxxxxx" dir="ltr">
          </div>

          <div class="mb-3 bg-gradient-to-r from-amber-900/20 to-slate-900/50 p-3 rounded-lg border border-amber-500/30">
            <label class="block text-[11px] font-bold text-amber-400 mb-2 flex items-center gap-1">
              <i class="fa-solid fa-crown"></i> طريقة الدفع
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <div class="w-4 h-4 rounded-full border-2 border-amber-500 flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-amber-500"></div>
              </div>
              <span class="text-amber-100 font-bold text-[11px]">الدفع من رصيد المحفظة</span>
            </label>
            <input type="hidden" name="payment_method" value="wallet">
          </div>

          <button type="submit" id="submitBtn" class="w-full bg-gradient-to-r from-amber-500 to-yellow-600 text-black font-black py-2 rounded-lg hover:shadow-[0_0_20px_rgba(251,191,36,0.4)] transition text-xs" <%= packages.length === 0 && (!samacardPackages || samacardPackages.length === 0) ? 'disabled' : '' %>>
            <%= packages.length === 0 && (!samacardPackages || samacardPackages.length === 0) ? 'غير متاح حالياً' : 'تأكيد الطلب' %>
          </button>
        </form>
      </div>

      <div>
        <details class="bg-slate-900/80 rounded-xl border border-slate-800 overflow-hidden group">
          <summary class="p-3 text-sm font-black text-white cursor-pointer flex items-center justify-between select-none hover:bg-slate-800/50 transition">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-clock-rotate-left text-cyan-400"></i> سجل طلباتك
            </div>
            <span class="text-[10px] bg-slate-800 px-2 py-1 rounded text-slate-400 group-open:bg-cyan-900/50 group-open:text-cyan-300 transition">اضغط للعرض</span>
          </summary>
          <div id="orderHistory" class="p-3 space-y-2 max-h-64 overflow-y-auto border-t border-slate-800">
            <div class="text-center py-6 bg-slate-900/50 rounded-xl border border-slate-800">
              <p class="text-slate-500 text-xs font-bold">جاري تحميل السجل...</p>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>

  <script>
  function updateSelectedPackage(selectEl) {
    const selectedOption = selectEl.options[selectEl.selectedIndex];
    document.getElementById('selectedProductId').value = selectedOption.value;
    document.getElementById('selectedPackageName').value = selectedOption.getAttribute('data-name');
    document.getElementById('selectedPrice').value = selectedOption.getAttribute('data-price');
    if (window.GamingSound) window.GamingSound.play();
  }

  document.addEventListener('DOMContentLoaded', function() {
    const userPhone = localStorage.getItem('apex_user_phone');
    if (userPhone) {
      document.getElementById('userPhone').value = userPhone;
      loadHistory(userPhone);
      fetch('/api/user-balance/' + userPhone).then(r => r.json()).then(data => {
        const badge = document.getElementById('balanceBadge');
        if (badge && data.balance > 0) {
          badge.innerText = '$' + data.balance.toFixed(2);
          badge.classList.remove('hidden');
        }
      }).catch(() => {});
    }

    const form = document.getElementById('orderForm');
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const phone = formData.get('user_phone');
        localStorage.setItem('apex_user_phone', phone);

        const isSamacard = document.getElementById('isSamacard')?.value === 'true';
        const btn = document.getElementById('submitBtn');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإرسال...';

        try {
          let res;
          if (isSamacard) {
            res = await fetch('/api/samacard/buy', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                user_phone: phone,
                player_id: formData.get('player_id'),
                product_id: document.getElementById('selectedProductId').value,
                package_name: document.getElementById('selectedPackageName').value,
                price_usd: document.getElementById('selectedPrice').value
              })
            });
          } else {
            res = await fetch('/games/<%= encodeURIComponent(game.name) %>/order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                player_id: formData.get('player_id'),
                package_name: document.getElementById('selectedPackageName').value,
                price: document.getElementById('selectedPrice').value,
                user_phone: phone,
                payment_method: 'wallet'
              })
            });
          }

          const result = await res.json();
          if (res.ok && result.success) {
            btn.innerHTML = '✅ ' + (result.message || 'تم الشحن بنجاح');
            btn.classList.add('from-green-500', 'to-green-600');
            setTimeout(() => { btn.innerHTML = 'تأكيد الطلب'; btn.classList.remove('from-green-500', 'to-green-600'); }, 3000);
            this.reset();
            document.getElementById('userPhone').value = phone;
            loadHistory(phone);
          } else {
            alert(result.message || 'حدث خطأ');
            btn.innerHTML = 'تأكيد الطلب';
          }
        } catch(err) {
          alert('حدث خطأ في الاتصال');
          btn.innerHTML = 'تأكيد الطلب';
        }
      });
    }

    function loadHistory(phone) {
      const container = document.getElementById('orderHistory');
      fetch('/api/topup-orders/' + phone)
        .then(r => r.json())
        .then(orders => {
          if (orders.length === 0) {
            container.innerHTML = '<div class="text-center py-6 bg-slate-900/50 rounded-xl border border-slate-800"><p class="text-slate-500 text-xs font-bold">لا توجد طلبات سابقة.</p></div>';
            return;
          }
          container.innerHTML = '';
          orders.forEach(o => {
            let statusColor = o.status === 'approved' ? 'text-green-400 bg-green-400/10 border-green-400/20' : o.status === 'rejected' ? 'text-red-400 bg-red-400/10 border-red-400/20' : 'text-amber-400 bg-amber-400/10 border-amber-400/20';
            let statusText = o.status === 'approved' ? '✅ تم القبول' : o.status === 'rejected' ? '❌ مرفوض' : '⏳ قيد المراجعة';
            container.innerHTML += `
              <div class="bg-slate-900/80 rounded-lg p-2 border border-slate-800 flex justify-between items-center">
                <div>
                  <h4 class="text-xs font-bold text-white">${o.package_name}</h4>
                  <p class="text-[10px] text-slate-400 mt-0.5">ID: ${o.player_id}</p>
                  ${o.rejection_reason ? `<p class="text-[10px] text-red-400 mt-1 font-bold">السبب: ${o.rejection_reason}</p>` : ''}
                </div>
                <div class="text-right">
                  <div class="text-sm font-black text-cyan-400 mb-1">$${o.price}</div>
                  <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold ${statusColor}">${statusText}</span>
                </div>
              </div>
            `;
          });
        });
    }
  });
  </script>
  <script src="/gaming-sound.js"></script>
</body>
</html>
