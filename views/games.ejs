
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><title>شحن الألعاب</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] }, colors: { neon: { blue: '#00f3ff', green: '#39ff14' } } } } }</script>
<style> body { background-color: #050505; color: white; background-image: radial-gradient(circle at 50% 0%, rgba(0,243,255,0.1), transparent 50%); } .neon-text { text-shadow: 0 0 10px rgba(0,243,255,0.8); } </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
<nav class="bg-black/50 backdrop-blur-md border-b border-cyan-500/20 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
    <a href="/" class="flex items-center gap-2"><i class="fa-solid fa-arrow-right text-cyan-400"></i> <span class="font-bold">العودة للمتجر</span></a>
    <span class="text-xl font-black neon-text">APEX GAMING</span>
  </div>
</nav>
<div class="max-w-5xl mx-auto px-4 py-10 flex-1 w-full">
  <h1 class="text-4xl font-black text-center mb-10 neon-text">اختر لعبتك</h1>
  <% if (games.length === 0) { %>
    <div class="text-center text-slate-500 py-20 text-xl font-bold">لا توجد ألعاب متاحة حالياً</div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% games.forEach(game => { %>
        <a href="/games/<%= encodeURIComponent(game.name) %>" class="relative rounded-3xl overflow-hidden group border-2 border-slate-800 hover:border-cyan-400 transition-all duration-300">
          <img src="<%= game.image_url || 'https://via.placeholder.com/400x200?text=' + game.name %>" class="w-full h-56 object-cover group-hover:scale-110 transition duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-3xl font-black text-white drop-shadow-lg"><%= game.name %></h3>
            <p class="text-cyan-400 text-sm font-bold mt-1"><i class="fa-solid fa-bolt"></i> شحن فوري</p>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
</body>
</html>
