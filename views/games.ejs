<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gaming Zone | شحن الألعاب | Apex فون</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: { sans: ['Cairo', 'sans-serif'] },
        colors: {
          neon: { blue: '#00f3ff', pink: '#ff00e5', green: '#39ff14', dark: '#050505' }
        }
      }
    }
  }
</script>
<style>
  body {
    background-color: #050505;
    background-image: 
      radial-gradient(circle at 15% 50%, rgba(0, 243, 255, 0.08) 0%, transparent 40%),
      radial-gradient(circle at 85% 30%, rgba(255, 0, 229, 0.08) 0%, transparent 40%);
    color: #ffffff;
    overflow-x: hidden;
  }
  
  .cyber-grid {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-image: linear-gradient(rgba(0, 243, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 243, 255, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    z-index: -1;
    pointer-events: none;
  }

  .game-card {
    background: linear-gradient(135deg, #111111 0%, #0a0a0a 100%);
    border: 1px solid #222;
    position: relative;
    clip-path: polygon(8% 0, 100% 0, 100% 88%, 92% 100%, 0 100%, 0 12%);
    transition: all 0.3s ease;
  }
  .game-card::before {
    content: ''; position: absolute; inset: 0;
    border: 1.5px solid transparent;
    background: linear-gradient(45deg, #00f3ff, #ff00e5) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
    clip-path: polygon(8% 0, 100% 0, 100% 88%, 92% 100%, 0 100%, 0 12%);
  }
  .game-card:hover::before { opacity: 1; }
  .game-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px -8px rgba(0, 243, 255, 0.4);
  }

  .package-btn {
    background: rgba(0, 243, 255, 0.05);
    border: 1px solid rgba(0, 243, 255, 0.2);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .package-btn:hover {
    background: rgba(0, 243, 255, 0.15);
    border-color: #00f3ff;
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.4);
    transform: scale(1.02);
  }
  .package-btn::after {
    content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: 0.5s;
  }
  .package-btn:hover::after { left: 100%; }

  .neon-text {
    text-shadow: 0 0 8px rgba(0, 243, 255, 0.8), 0 0 15px rgba(0, 243, 255, 0.4);
  }

  .ticker-wrap { width: 100%; overflow: hidden; background: rgba(0,0,0,0.8); border-top: 1px solid #222; border-bottom: 1px solid #222; }
  .ticker { display: inline-block; white-space: nowrap; padding-right: 100%; animation: ticker 20s linear infinite; }
  @keyframes ticker { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(100%, 0, 0); } }
</style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
<div class="cyber-grid"></div>

<!-- شريط الأخبار المصغر -->
<div class="ticker-wrap py-0.5">
  <div class="ticker text-[9px] font-bold text-neon-green tracking-widest">
    ⚡ شحن فوري وآمن 100% | 🔥 أفضل الأسعار في السوق السوري | 🎮 جميع الألعاب متوفرة | 🛡️ ضمان استرجاع الأموال | ⚡ شحن فوري وآمن 100%
  </div>
</div>

<!-- شريط التنقل المصغر -->
<nav class="bg-black/50 backdrop-blur-md border-b border-neon-blue/20 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-3 h-12 flex justify-between items-center">
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 bg-gradient-to-br from-neon-blue to-blue-700 rounded-lg flex items-center justify-center shadow-[0_0_10px_rgba(0,243,255,0.5)] group-hover:scale-110 transition">
        <i class="fa-solid fa-gamepad text-black text-sm"></i>
      </div>
      <span class="text-sm font-black text-white tracking-wider">APEX <span class="text-neon-blue">GAMING</span></span>
    </a>
    <a href="/" class="text-[10px] font-bold text-slate-300 hover:text-neon-blue transition flex items-center gap-1">
      <i class="fa-solid fa-store"></i> المتجر الرئيسي
    </a>
  </div>
</nav>

<!-- القسم الرئيسي المصغر -->
<div class="relative py-8 px-3 text-center">
  <div class="absolute inset-0 bg-gradient-to-b from-neon-blue/10 to-transparent pointer-events-none"></div>
  <h1 class="text-3xl md:text-4xl font-black text-white mb-2 tracking-tighter neon-text">
    اشحن <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue to-neon-pink">قوتك</span>
  </h1>
  <p class="text-slate-400 text-xs md:text-sm max-w-lg mx-auto font-bold">
    وجهتك الأولى لشحن شدات ببجي، جواهر فري فاير، وبطاقات جوجل بلاي بأسعار لا تقبل المنافسة.
  </p>
  <div class="flex justify-center gap-4 mt-4 text-lg text-neon-blue/50">
    <i class="fa-brands fa-steam"></i>
    <i class="fa-brands fa-playstation"></i>
    <i class="fa-brands fa-xbox"></i>
    <i class="fa-solid fa-mobile-screen"></i>
  </div>
</div>

<!-- قائمة الألعاب المصغرة -->
<div class="max-w-5xl mx-auto px-3 pb-10 w-full flex-1">
  <% if (Object.keys(grouped).length === 0) { %>
    <div class="game-card p-8 text-center max-w-sm mx-auto">
      <i class="fa-solid fa-ghost text-4xl text-slate-700 mb-3 animate-pulse"></i>
      <h3 class="text-lg font-black text-slate-400 mb-1">قريباً جداً...</h3>
      <p class="text-slate-500 text-xs font-bold">نحن نجهز أقوى باقات الشحن.</p>
    </div>
  <% } else { %>
    <% Object.entries(grouped).forEach(([gameName, packages]) => { %>
      
      <div class="game-card mb-4 p-4">
        <!-- عنوان اللعبة -->
        <div class="flex items-center gap-3 mb-3 border-b border-slate-800 pb-2">
          <div class="w-10 h-10 bg-black border border-neon-blue rounded-lg flex items-center justify-center shadow-[0_0_10px_rgba(0,243,255,0.3)]">
            <i class="fa-solid fa-crosshairs text-lg text-neon-blue"></i>
          </div>
          <div>
            <h2 class="text-lg font-black text-white tracking-wide"><%= gameName %></h2>
            <p class="text-[9px] text-neon-green font-bold"><i class="fa-solid fa-bolt"></i> تسليم فوري</p>
          </div>
        </div>
        
        <!-- الباقات -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          <% packages.forEach(pkg => { %>
            <a href="https://wa.me/963980259127?text=مرحباً،%20أريد%20شحن%20<%= encodeURIComponent(pkg.package_name) %>%20للعبة%20<%= encodeURIComponent(gameName) %>" target="_blank" class="package-btn p-2.5 flex flex-col items-center justify-center text-center group cursor-pointer">
              <div class="text-xl mb-1 group-hover:scale-125 transition duration-300">
                <% if(gameName.toLowerCase().includes('pubg')) { %>
                  <i class="fa-solid fa-gun text-yellow-500"></i>
                <% } else if (gameName.toLowerCase().includes('free') || gameName.toLowerCase().includes('fire')) { %>
                  <i class="fa-solid fa-gem text-red-500"></i>
                <% } else { %>
                  <i class="fa-solid fa-coins text-yellow-400"></i>
                <% } %>
              </div>
              <h3 class="text-[11px] font-black text-white mb-0.5 group-hover:text-neon-blue transition truncate w-full"><%= pkg.package_name %></h3>
              <div class="text-sm font-black text-neon-green font-mono">$<%= pkg.price %></div>
            </a>
          <% }) %>
        </div>
      </div>

    <% }) %>
  <% } %>
</div>

<footer class="border-t border-slate-800 py-3 text-center bg-black/80 mt-auto">
  <p class="text-slate-500 font-bold text-[10px]">© 2026 APEX GAMING ZONE. جميع الحقوق محفوظة.</p>
</footer>

</body>
</html>