<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gaming Zone | شحن الألعاب | Apex فون</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] }, colors: { neon: { blue: '#00f3ff', pink: '#ff00e5', green: '#39ff14' } } } } }
  </script>
  <style>
    body { background-color: #050505; background-image: radial-gradient(circle at 15% 50%, rgba(0,243,255,0.08) 0%, transparent 40%), radial-gradient(circle at 85% 30%, rgba(255,0,229,0.08) 0%, transparent 40%); color: #fff; overflow-x: hidden; }
    .cyber-grid { position: fixed; inset: 0; background-image: linear-gradient(rgba(0,243,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,243,255,0.05) 1px, transparent 1px); background-size: 20px 20px; z-index: -1; pointer-events: none; }
    .game-card { background: linear-gradient(135deg, #111 0%, #0a0a0a 100%); border: 1px solid #222; position: relative; clip-path: polygon(8% 0, 100% 0, 100% 88%, 92% 100%, 0 100%, 0 12%); transition: all 0.3s ease; }
    .game-card:hover { transform: translateY(-4px); border-color: #00f3ff; box-shadow: 0 10px 30px -10px rgba(0,243,255,0.5); }
    .neon-text { text-shadow: 0 0 8px rgba(0,243,255,0.8), 0 0 15px rgba(0,243,255,0.4); }
    .ticker-wrap { width: 100%; overflow: hidden; background: rgba(0,0,0,0.8); border-top: 1px solid #222; border-bottom: 1px solid #222; }
    .ticker { display: inline-block; white-space: nowrap; padding-right: 100%; animation: ticker 20s linear infinite; }
    @keyframes ticker { 0% { transform: translate3d(0,0,0); } 100% { transform: translate3d(100%,0,0); } }
  </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
  <div class="cyber-grid"></div>
  <div class="ticker-wrap py-0.5">
    <div class="ticker text-[9px] font-bold text-neon-green tracking-widest">
      ⚡ شحن فوري وآمن 100% | 🔥 أفضل الأسعار في السوق السوري | 🎮 جميع الألعاب متوفرة | 🛡️ ضمان استرجاع الأموال | ⚡ شحن فوري وآمن 100%
    </div>
  </div>
  <nav class="bg-black/50 backdrop-blur-md border-b border-neon-blue/20 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-3 h-12 flex justify-between items-center">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 bg-gradient-to-br from-neon-blue to-blue-700 rounded-lg flex items-center justify-center shadow-[0_0_10px_rgba(0,243,255,0.5)] group-hover:scale-110 transition">
          <i class="fa-solid fa-gamepad text-black text-sm"></i>
        </div>
        <span class="text-sm font-black text-white tracking-wider">APEX <span class="text-neon-blue">GAMING</span></span>
      </a>
      <a href="/topup-balance" class="text-[10px] font-bold text-green-400 hover:text-green-300 transition flex items-center gap-1 mr-3">
        <i class="fa-solid fa-wallet"></i> شحن رصيد
      </a>
      <a href="/" class="text-[10px] font-bold text-slate-300 hover:text-neon-blue transition flex items-center gap-1">
        <i class="fa-solid fa-store"></i> المتجر الرئيسي
      </a>
    </div>
  </nav>
  <div class="relative py-8 px-3 text-center">
    <div class="absolute inset-0 bg-gradient-to-b from-neon-blue/10 to-transparent pointer-events-none"></div>
    <h1 class="text-3xl md:text-4xl font-black text-white mb-2 tracking-tighter neon-text">
      اشحن <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue to-neon-pink">قوتك</span>
    </h1>
    <p class="text-slate-400 text-xs md:text-sm max-w-lg mx-auto font-bold">
      وجهتك الأولى لشحن شدات ببجي، جواهر فري فاير، وبطاقات جوجل بلاي بأسعار لا تقبل المنافسة.
    </p>
    <div class="flex justify-center gap-4 mt-4 text-lg text-neon-blue/50">
      <i class="fa-brands fa-steam"></i>
      <i class="fa-brands fa-playstation"></i>
      <i class="fa-brands fa-xbox"></i>
      <i class="fa-solid fa-mobile-screen"></i>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-3 pb-10 w-full flex-1">
    <% if (!games || games.length === 0) { %>
      <div class="game-card p-8 text-center max-w-sm mx-auto">
        <i class="fa-solid fa-ghost text-4xl text-slate-700 mb-3 animate-pulse"></i>
        <h3 class="text-lg font-black text-slate-400 mb-1">قريباً جداً...</h3>
        <p class="text-slate-500 text-xs font-bold">نحن نجهز أقوى باقات الشحن.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% games.forEach(game => { %>
          <a href="/games/<%= encodeURIComponent(game.name) %>" class="game-card p-4 flex flex-col items-center text-center group">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl overflow-hidden mb-3 border-2 border-neon-blue/30 group-hover:border-neon-blue transition shadow-[0_0_20px_rgba(0,243,255,0.2)] group-hover:shadow-[0_0_30px_rgba(0,243,255,0.5)]">
              <% if (game.image_url) { %>
                <img src="<%= game.image_url %>" alt="<%= game.name %>" class="w-full h-full object-cover" loading="lazy">
              <% } else { %>
                <div class="w-full h-full bg-black flex items-center justify-center">
                  <i class="fa-solid fa-gamepad text-2xl text-neon-blue"></i>
                </div>
              <% } %>
            </div>
            <h3 class="text-sm font-black text-white mb-0.5 group-hover:text-neon-blue transition"><%= game.name_ar || game.name %></h3>
            <p class="text-[10px] text-slate-500 font-bold mb-2"><%= game.name %></p>
            <% if (game.delivery_time) { %>
              <p class="text-[9px] text-neon-green font-bold mb-2"><i class="fa-solid fa-bolt"></i> <%= game.delivery_time %></p>
            <% } %>
            <span class="text-[10px] bg-neon-blue/10 text-neon-blue border border-neon-blue/30 rounded-full px-3 py-1 font-bold group-hover:bg-neon-blue group-hover:text-black transition">
              <%= game.packages_count %> باقة
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
  <footer class="border-t border-slate-800 py-3 text-center bg-black/80 mt-auto">
    <p class="text-slate-500 font-bold text-[10px]">© 2026 APEX GAMING ZONE. جميع الحقوق محفوظة.</p>
  </footer>
<script src="/gaming-sound.js"></script>

<script>
  // إرسال رقم الهاتف للخادم لربطه بسجل الزيارة
  const uPhone = localStorage.getItem('apex_user_phone');
  if (uPhone) {
    fetch('/api/notifications/' + uPhone, { headers: { 'x-user-phone': uPhone } }).catch(()=>{});
  }
</script>
<script src="/tracker.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const userPhone = localStorage.getItem('apex_user_phone');
      if (userPhone) {
        fetch('/api/user-balance/' + userPhone)
          .then(r => r.json())
          .then(data => {
            const badge = document.getElementById('balanceBadge');
            if (badge && data.balance > 0) {
              badge.innerText = '
</html>
 + data.balance.toFixed(2);
              badge.classList.remove('hidden');
            }
          }).catch(() => {});
      }
    });
  </script>
  
<script src="/chatbot.js?v=13"></script>
</body>
</html>
