<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gaming Zone | شحن الألعاب | Apex فون</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] }, colors: { neon: { blue: '#00f3ff', pink: '#ff00e5', green: '#39ff14' } } } } }
  </script>
  <style>
    body { background-color: #050505; background-image: radial-gradient(circle at 15% 50%, rgba(0,243,255,0.08) 0%, transparent 40%), radial-gradient(circle at 85% 30%, rgba(255,0,229,0.08) 0%, transparent 40%); color: #fff; overflow-x: hidden; }
    .cyber-grid { position: fixed; inset: 0; background-image: linear-gradient(rgba(0,243,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,243,255,0.05) 1px, transparent 1px); background-size: 20px 20px; z-index: -1; pointer-events: none; }
    .game-card { background: linear-gradient(135deg, #111 0%, #0a0a0a 100%); border: 1px solid #222; position: relative; clip-path: polygon(8% 0, 100% 0, 100% 88%, 92% 100%, 0 100%, 0 12%); transition: all 0.3s ease; }
    .game-card:hover { transform: translateY(-4px); border-color: #00f3ff; box-shadow: 0 10px 30px -10px rgba(0,243,255,0.5); }
    .neon-text { text-shadow: 0 0 8px rgba(0,243,255,0.8), 0 0 15px rgba(0,243,255,0.4); }
    .ticker-wrap { width: 100%; overflow: hidden; background: rgba(0,0,0,0.8); border-top: 1px solid #222; border-bottom: 1px solid #222; }
    .ticker { display: inline-block; white-space: nowrap; padding-right: 100%; animation: ticker 20s linear infinite; }
    @keyframes ticker { 0% { transform: translate3d(0,0,0); } 100% { transform: translate3d(100%,0,0); } }
  </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
  <div class="cyber-grid"></div>
  <div class="ticker-wrap py-0.5">
    <div class="ticker text-[8px] font-bold text-neon-green tracking-widest">
      ⚡ شحن فوري وآمن 100% | 🔥 أفضل الأسعار في السوق السوري | 🎮 جميع الألعاب متوفرة | 🛡️ ضمان استرجاع الأموال | ⚡ شحن فوري وآمن 100%
    </div>
  </div>
  
  <!-- تصغير النافبار -->
  <nav class="bg-black/50 backdrop-blur-md border-b border-neon-blue/20 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-3 h-10 flex justify-between items-center">
      <a href="/" class="flex items-center gap-1.5 group">
        <div class="w-6 h-6 bg-gradient-to-br from-neon-blue to-blue-700 rounded flex items-center justify-center shadow-[0_0_10px_rgba(0,243,255,0.5)] group-hover:scale-110 transition">
          <i class="fa-solid fa-gamepad text-black text-[10px]"></i>
        </div>
        <span class="text-xs font-black text-white tracking-wider">APEX <span class="text-neon-blue">GAMING</span></span>
      </a>
      <div class="flex items-center">
        <a href="/topup-balance" class="text-[9px] font-bold text-green-400 hover:text-green-300 transition flex items-center gap-1 mr-2">
          <i class="fa-solid fa-wallet"></i> شحن رصيد
          <span id="balanceBadge" class="hidden bg-green-900/50 border border-green-500 rounded px-1 py-0.5 text-[8px] font-black text-green-400"></span>
        </a>
        <a href="/games" class="text-[9px] font-bold text-slate-300 hover:text-neon-blue transition flex items-center gap-1">
          <i class="fa-solid fa-arrow-right"></i> رجوع
        </a>
      </div>
    </div>
  </nav>

  <!-- تصغير الهيرو (العنوان والوصف) -->
  <div class="relative py-4 px-3 text-center">
    <div class="absolute inset-0 bg-gradient-to-b from-neon-blue/10 to-transparent pointer-events-none"></div>
    <h1 class="text-2xl md:text-3xl font-black text-white mb-1 tracking-tighter neon-text">
      اشحن <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue to-neon-pink">قوتك</span>
    </h1>
    <p class="text-slate-400 text-[10px] md:text-xs max-w-lg mx-auto font-bold">
      وجهتك الأولى لشحن شدات ببجي، جواهر فري فاير، وبطاقات جوجل بلاي بأسعار لا تقبل المنافسة.
    </p>
    <div class="flex justify-center gap-3 mt-2 text-xs text-neon-blue/50">
      <i class="fa-brands fa-steam"></i>
      <i class="fa-brands fa-playstation"></i>
      <i class="fa-brands fa-xbox"></i>
      <i class="fa-solid fa-mobile-screen"></i>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-2 pb-8 w-full flex-1">
    <% if (!games || games.length === 0) { %>
      <div class="game-card p-6 text-center max-w-xs mx-auto">
        <i class="fa-solid fa-ghost text-3xl text-slate-700 mb-2 animate-pulse"></i>
        <h3 class="text-sm font-black text-slate-400 mb-1">قريباً جداً...</h3>
        <p class="text-slate-500 text-[10px] font-bold">نحن نجهز أقوى باقات الشحن.</p>
      </div>
    <% } else { %>
      <!-- تصغير المسافات بين الكروت -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 md:gap-3">
        <% games.forEach(game => { %>
          <!-- تصغير الكرت نفسه والمسافات الداخلية -->
          <a href="/games/<%= encodeURIComponent(game.name) %>" class="game-card p-2.5 flex flex-col items-center text-center group">
            <div class="w-14 h-14 md:w-16 md:h-16 rounded-xl overflow-hidden mb-1.5 border border-neon-blue/30 group-hover:border-neon-blue transition shadow-[0_0_15px_rgba(0,243,255,0.2)] group-hover:shadow-[0_0_20px_rgba(0,243,255,0.5)]">
              <% if (game.image_url) { %>
                <img src="<%= game.image_url %>" alt="<%= game.name %>" class="w-full h-full object-cover" loading="lazy">
              <% } else { %>
                <div class="w-full h-full bg-black flex items-center justify-center">
                  <i class="fa-solid fa-gamepad text-lg text-neon-blue"></i>
                </div>
              <% } %>
            </div>
            <h3 class="text-xs font-black text-white mb-0.5 group-hover:text-neon-blue transition"><%= game.name_ar || game.name %></h3>
            <p class="text-[9px] text-slate-500 font-bold mb-1"><%= game.name %></p>
            <% if (game.delivery_time) { %>
              <p class="text-[8px] text-neon-green font-bold mb-1"><i class="fa-solid fa-bolt"></i> <%= game.delivery_time %></p>
            <% } %>
            <span class="text-[8px] bg-neon-blue/10 text-neon-blue border border-neon-blue/30 rounded-full px-2 py-0.5 font-bold group-hover:bg-neon-blue group-hover:text-black transition">
              <%= game.packages_count %> باقة
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- تصغير الفوتر -->
  <footer class="border-t border-slate-800 py-2 text-center bg-black/80 mt-auto">
    <p class="text-slate-500 font-bold text-[8px]">© 2026 APEX GAMING ZONE. جميع الحقوق محفوظة.</p>
  </footer>

<script src="/gaming-sound.js"></script>

<script>
  // إرسال رقم الهاتف للخادم لربطه بسجل الزيارة
  const uPhone = localStorage.getItem('apex_user_phone');
  if (uPhone) {
    fetch('/api/notifications/' + uPhone, { headers: { 'x-user-phone': uPhone } }).catch(()=>{});
  }
</script>
<script src="/tracker.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const userPhone = localStorage.getItem('apex_user_phone');
      if (userPhone) {
        fetch('/api/user-balance/' + userPhone)
          .then(r => r.json())
          .then(data => {
            const badge = document.getElementById('balanceBadge');
            if (badge && data.balance > 0) {
              // إصلاح الخطأ البرمجي الذي كان موجوداً هنا
              badge.innerText = '$' + data.balance.toFixed(2);
              badge.classList.remove('hidden');
            }
          }).catch(() => {});
      }
    });
  </script>

<script src="/chatbot.js?v=14"></script>
</body>
</html>
