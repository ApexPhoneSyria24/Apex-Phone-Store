<script>
  // 1. الأصوات
  const girlAudio = new Audio('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=en&q=Welcome%20to%20Apex%20Phone%20Syria');
  girlAudio.load();
  function playFirstModalSounds() {
    try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); const osc = ctx.createOscillator(); const gain = ctx.createGain(); osc.type = 'sine'; osc.frequency.setValueAtTime(400, ctx.currentTime); osc.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 0.1); gain.gain.setValueAtTime(0.1, ctx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1); osc.connect(gain); gain.connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + 0.1); } catch(e) {}
    try { const pCtx = new (window.AudioContext || window.webkitAudioContext)(); const playNote = (f, t) => { const o = pCtx.createOscillator(); const g = pCtx.createGain(); o.type = 'sine'; o.frequency.value = f; g.gain.setValueAtTime(0, pCtx.currentTime + t); g.gain.linearRampToValueAtTime(0.15, pCtx.currentTime + t + 0.05); g.gain.exponentialRampToValueAtTime(0.001, pCtx.currentTime + t + 2.5); o.connect(g); g.connect(pCtx.destination); o.start(pCtx.currentTime + t); o.stop(pCtx.currentTime + t + 2.5); }; playNote(261.63, 0); playNote(329.63, 0.1); playNote(392.00, 0.2); playNote(523.25, 0.3); } catch(e) {}
  }
  function playSecondModalSounds() {
    playFirstModalSounds();
    try { girlAudio.currentTime = 0; girlAudio.play().catch(e => { if ('speechSynthesis' in window) { window.speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance("Welcome to Apex Phone Syria"); u.lang = 'en-US'; u.rate = 0.9; u.pitch = 1.0; window.speechSynthesis.speak(u); } }); } catch(e) {}
  }

  // 2. النوافذ
  function closeFraudModal() { const m = document.getElementById('fraudModal'); const c = document.getElementById('modalContent'); c.classList.remove('opacity-100', 'translate-y-0'); c.classList.add('opacity-0', 'translate-y-4'); setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); const s = document.getElementById('servicesModal'); const sc = document.getElementById('servicesContent'); if(s) { s.classList.remove('hidden'); s.classList.add('flex'); setTimeout(() => { sc.classList.remove('opacity-0', 'translate-y-4'); sc.classList.add('opacity-100', 'translate-y-0'); }, 100); } }, 300); }
  function closeServicesModal() { const m = document.getElementById('servicesModal'); const c = document.getElementById('servicesContent'); c.classList.remove('opacity-100', 'translate-y-0'); c.classList.add('opacity-0', 'translate-y-4'); setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300); }

  // 3. التحميل والإشعارات
  document.addEventListener("DOMContentLoaded", function() {
    // التحميل
    const preloader = document.getElementById('preloader');
    const navEntries = performance.getEntriesByType("navigation");
    const navType = navEntries.length > 0 ? navEntries[0].type : "navigate";
    const isReload = (navType === "reload");
    const isBack = (navType === "back_forward");
    const isFirstVisit = (sessionStorage.getItem('apex_visited') !== 'true');

    if (isBack || (!isFirstVisit && !isReload)) {
        if (preloader) preloader.style.display = 'none';
    } else {
        sessionStorage.setItem('apex_visited', 'true');
        setTimeout(() => { if (preloader) preloader.classList.add('hidden'); setTimeout(() => { const m = document.getElementById('fraudModal'); const c = document.getElementById('modalContent'); if(m) { m.classList.remove('hidden'); m.classList.add('flex'); setTimeout(() => { c.classList.remove('opacity-0', 'translate-y-4'); c.classList.add('opacity-100', 'translate-y-0'); }, 50); } }, 1500); }, 2000); 
    }

    // الإشعارات
    let userPhone = localStorage.getItem('apex_user_phone');
    if (!userPhone) {
        userPhone = 'guest_' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem('apex_user_phone', userPhone);
    }

    // إرسال طلب الترحيب
    fetch('/api/notifications/welcome', { 
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: userPhone }) 
    }).then(() => checkNotifications()).catch(e => console.log(e));

    function checkNotifications() {
        fetch('/api/notifications/' + userPhone).then(res => res.json()).then(data => {
            const count = document.getElementById('notifCount');
            if (count) { 
                const unreadCount = data.filter(n => n.is_read === 0).length;
                if (unreadCount > 0) { 
                    count.textContent = unreadCount; 
                    count.classList.remove('hidden'); 
                } else { 
                    count.classList.add('hidden'); 
                } 
            }
        }).catch(e => {});
    }

    function showNotifications() {
        const modal = document.getElementById('notifModal');
        const notifContent = document.getElementById('notifContent');
        const list = document.getElementById('notifList');
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => notifContent.classList.remove('scale-95'), 10);
        
        list.innerHTML = '<div class="text-center py-4 text-slate-500"><i class="fa-solid fa-spinner fa-spin text-2xl"></i></div>';

        fetch('/api/notifications/' + userPhone).then(res => res.json()).then(data => {
            list.innerHTML = '';
            if (data.length === 0) {
                list.innerHTML = '<div class="text-center py-8"><div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3"><i class="fa-solid fa-bell-slash text-slate-400 text-2xl"></i></div><p class="text-slate-500 font-bold text-sm">لا توجد إشعارات</p></div>';
                return;
            }
            
            data.forEach(n => {
                const isUnread = n.is_read === 0;
                const bgClass = isUnread ? 'bg-brand-50 border-brand-200' : 'bg-slate-50 border-slate-200';
                const iconClass = isUnread ? 'bg-brand-500 text-white' : 'bg-slate-200 text-slate-500';
                
                list.innerHTML += '<div class="' + bgClass + ' border p-3 rounded-xl flex items-start gap-3 transition mb-2"><div class="w-8 h-8 rounded-full ' + iconClass + ' flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fa-solid fa-bell text-xs"></i></div><div><p class="text-xs font-bold text-slate-800 leading-relaxed">' + n.message + '</p></div></div>';
            });

            // تعليم الإشعارات كمقروءة في الخلفية
            const hasUnread = data.some(n => n.is_read === 0);
            if (hasUnread) {
                fetch('/api/notifications/read/' + userPhone, { method: 'POST' }).then(() => checkNotifications());
            }
        });
    }

    function closeNotifModal() {
        const modal = document.getElementById('notifModal');
        const notifContent = document.getElementById('notifContent');
        notifContent.classList.add('scale-95');
        setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 300);
    }

    window.checkNotifications = checkNotifications;
    window.showNotifications = showNotifications;
    window.closeNotifModal = closeNotifModal;
    
    setInterval(checkNotifications, 5000);
    checkNotifications();

    // البانرات
    var bannerSwiper = new Swiper(".banner-swiper", { loop: true, autoplay: { delay: 3000, disableOnInteraction: false }, pagination: { el: ".swiper-pagination", clickable: true } });
  });

  if ('serviceWorker' in navigator) { window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js'); }); }
</script>

