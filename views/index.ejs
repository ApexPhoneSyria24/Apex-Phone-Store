<script>
function playGamingClick() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(900, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.1);
    gain.gain.setValueAtTime(0.15, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(); osc.stop(ctx.currentTime + 0.12);
  } catch(e) {}
}

function redirectToGames(e) {
  if (e) { e.preventDefault(); e.stopPropagation(); }
  
  // 1. نقرة الزر
  playGamingClick();
  
  // 2. إظهار شاشة التحميل
  const loader = document.getElementById('gamesLoader');
  if (loader) {
    loader.classList.remove('hidden');
    loader.classList.add('flex');
    loader.classList.add('opacity-100');
    loader.classList.remove('opacity-0');
  }
  
  // 3. تشغيل الصوت الرجولي العميق (ملف MP3)
  const audio = new Audio('/sounds/welcome_games.mp3');
  audio.volume = 1.0;
  
  let transitionStarted = false;
  function finishTransition() {
    if (transitionStarted) return;
    transitionStarted = true;
    
    if (loader) {
      loader.classList.remove('opacity-100');
      loader.classList.add('opacity-0');
    }
    setTimeout(function() {
      window.location.href = '/games';
    }, 800);
  }
  
  // انتظار انتهاء الصوت الفعلي
  audio.onended = finishTransition;
  audio.onerror = finishTransition; // في حال فشل تحميل الملف
  
  audio.play().catch(function() {
    // خطة بديلة: الانتظار 4 ثوانٍ ثم الانتقال
    setTimeout(finishTransition, 4000);
  });
  
  // حد أقصى 8 ثوانٍ في حال تعليق الصوت
  const safetyTimeout = setTimeout(finishTransition, 8000);
}
</script>


