      const modal = document.getElementById('verificationModal');
      const box = document.getElementById('verificationModalBox');
      box.classList.replace('scale-100', 'scale-95');
      modal.style.opacity = '0';
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        sessionStorage.setItem('apex_verification_seen', 'true');
        if (document.getElementById('hideVerifCheckbox') && document.getElementById('hideVerifCheckbox').checked) {
          localStorage.setItem('apex_hide_verif', 'true');
        }
        // إظهار نافذة السوشيال ميديا بعد إغلاق التوثيق
        if (window.showSocialModal) setTimeout(window.showSocialModal, 800);
      }, 300);
    }
