    document.addEventListener('DOMContentLoaded', function() {
      if (!sessionStorage.getItem('apex_scam_warning_seen') && !localStorage.getItem('apex_hide_scam_warning')) {
        setTimeout(() => {
          const modal = document.getElementById('scamWarningModal');
          const box = document.getElementById('scamModalBox');
          if(modal && box) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => { modal.style.opacity = '1'; box.classList.replace('scale-95', 'scale-100'); }, 50);
          }
        }, 1500);
      }
    });

    function acceptScamWarning() {
      const modal = document.getElementById('scamWarningModal');
      const box = document.getElementById('scamModalBox');
      box.classList.replace('scale-100', 'scale-95');
      modal.style.opacity = '0';
      
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        sessionStorage.setItem('apex_scam_warning_seen', 'true');
        if (document.getElementById('hideScamCheckbox') && document.getElementById('hideScamCheckbox').checked) {
