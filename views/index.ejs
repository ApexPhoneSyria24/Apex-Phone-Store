      // إذا لم يوجد ID أو كان بالصيغة القديمة (#APX)، ننشئ واحداً جديداً
      if (!vid || !vid.startsWith('Apex-')) {
        vid = 'Apex-' + Math.random().toString(36).substring(2, 9).toUpperCase();
        localStorage.setItem('apex_visitor_id', vid);
      }
      const displayEl = document.getElementById('visitor-id-display');
      if (displayEl) displayEl.innerText = vid;
    });

    function copyVisitorId() {
      const vid = localStorage.getItem('apex_visitor_id');
      if (!vid) return;
      navigator.clipboard.writeText(vid).then(() => {
        const toast = document.getElementById('copyToast');
        toast.classList.remove('opacity-0');
        setTimeout(() => toast.classList.add('opacity-0'), 2000);
      }).catch(err => console.error('Copy failed', err));
    }
  </script>

