  <script>
    function openNotifModal() {
      const modal = document.getElementById('notifModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      
      let phone = localStorage.getItem('apex_user_phone');
      const content = document.getElementById('notifContent');
      
      if (!phone) {
        content.innerHTML = `
          <div class="text-center py-2">
            <p class="text-slate-300 mb-4 text-sm">أدخل رقم هاتفك لعرض الإشعارات الخاصة بك</p>
            <input type="tel" id="notifPhoneInput" class="w-full bg-slate-200 text-slate-800 border border-slate-300 p-3 rounded-xl mb-3 border border-slate-600 focus:border-blue-500 outline-none text-center font-bold" placeholder="09xxxxxxxx" dir="ltr">
            <button onclick="fetchNotifs()" class="w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 transition">عرض الإشعارات</button>
          </div>
        `;
        return;
      }
      
      content.innerHTML = '<div class="text-center text-slate-400 py-1"><i class="fa-solid fa-spinner fa-spin text-2xl mb-3 text-blue-500"></i><br>جاري تحميل الإشعارات...</div>';
      loadNotifs(phone);
    }

    async function fetchNotifs() {
      const phone = document.getElementById('notifPhoneInput').value.trim();
      if (!phone || phone.length < 8) return alert('يرجى إدخال رقم هاتف صحيح');
      localStorage.setItem('apex_user_phone', phone);
      const content = document.getElementById('notifContent');
      content.innerHTML = '<div class="text-center text-slate-400 py-1"><i class="fa-solid fa-spinner fa-spin text-2xl mb-3 text-blue-500"></i><br>جاري تحميل الإشعارات...</div>';
      loadNotifs(phone);
    }

    async function loadNotifs(phone) {
      const content = document.getElementById('notifContent');
      try {
        const res = await fetch('/api/notifications/' + phone);
        const data = await res.json();
        
        if (data.length === 0) {
          content.innerHTML = '<div class="text-center text-slate-400 py-8"><i class="fa-regular fa-bell-slash text-4xl mb-3 text-slate-600"></i><br>لا توجد إشعارات حالياً.</div>';
        } else {
          content.innerHTML = data.map(n => `
            <div class="bg-[#112240] p-4 rounded-xl border ${n.is_read === 1 ? 'border-slate-700 opacity-70' : 'border-blue-500/40 shadow-[0_0_15px_rgba(59,130,246,0.15)]'} mb-3 transition-all hover:border-blue-400">
              <div class="text-[15px] font-bold text-white leading-relaxed drop-shadow-sm">${n.message}</div>
              <div class="text-xs text-blue-300/70 mt-2 font-mono border-t border-slate-700/50 pt-2 flex items-center gap-1" dir="ltr">
                <i class="fa-regular fa-clock text-[10px]"></i> ${n.created_at}
              </div>
            </div>
          `).join('');
          
          // تعليم الإشعارات كمقروءة وإخفاء النقطة الحمراء
          fetch('/api/notifications/read/' + phone, { method: 'POST' });
          const redDot = document.querySelector('button[onclick="openNotifModal()"] span');
          if (redDot) redDot.style.display = 'none';
        }
      } catch (e) {
        content.innerHTML = '<div class="text-center text-red-400 py-1">حدث خطأ في جلب الإشعارات. تحقق من اتصالك.</div>';
      }
    }

    function closeNotifModal() {
      const modal = document.getElementById('notifModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    
    // إغلاق النافذة عند النقر خارجها
    document.getElementById('notifModal').addEventListener('click', function(e) {
      if (e.target === this) closeNotifModal();
    });
  </script>
  

    <script>
      // كود مضمون لإغلاق النافذة
      document.addEventListener('DOMContentLoaded', function() {
        const closeBtn = document.getElementById('closeNotifBtn');
        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const modal = document.getElementById('notifModal');
            if (modal) {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
            }
          });
        }
      });
    </script>
  

