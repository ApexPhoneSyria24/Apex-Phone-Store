<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>اطلب موقعك | Apex Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    body { background: #050505; color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 15px; margin: 0; }
    
    .royal-card {
      background: linear-gradient(135deg, #0a0a0a 0%, #111 50%, #0a0a0a 100%);
      border: 1.5px solid rgba(212, 175, 55, 0.5);
      border-radius: 16px;
      width: 100%;
      max-width: 380px;
      padding: 20px 15px;
      position: relative;
      box-shadow: 0 0 40px rgba(212, 175, 55, 0.2);
      overflow: hidden;
    }
    
    .rotating-star {
      position: absolute;
      width: 8px;
      height: 8px;
      color: #d4af37;
      font-size: 12px;
      animation: orbit 6s linear infinite;
    }
    
    @keyframes orbit {
      0% { top: 0; left: 0; }
      25% { top: 0; left: calc(100% - 8px); }
      50% { top: calc(100% - 8px); left: calc(100% - 8px); }
      75% { top: calc(100% - 8px); left: 0; }
      100% { top: 0; left: 0; }
    }
    
    .royal-title {
      color: transparent;
      background-clip: text;
      -webkit-background-clip: text;
      background-image: linear-gradient(to right, #d4af37, #fcf6b5);
      font-weight: 900;
      font-size: 20px;
      margin-bottom: 5px;
      text-align: center;
    }
    
    .gold-input {
      width: 100%;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 8px;
      padding: 8px 12px;
      color: #fff;
      font-size: 12px;
      outline: none;
      transition: all 0.3s;
    }
    
    .gold-input:focus {
      border-color: #d4af37;
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
    }
    
    .gold-input::placeholder { color: #666; }
    
    .gold-btn {
      width: 100%;
      background: linear-gradient(135deg, #d4af37, #b8860b);
      color: #000;
      font-weight: 900;
      font-size: 14px;
      padding: 12px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
    }
    
    .gold-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(212, 175, 55, 0.6);
    }
    
    .gold-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    
    .radio-toggle {
      display: flex;
      gap: 8px;
    }
    
    .radio-toggle label {
      flex: 1;
      padding: 8px;
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 8px;
      text-align: center;
      cursor: pointer;
      font-size: 12px;
      font-weight: bold;
      transition: all 0.3s;
    }
    
    .radio-toggle input { display: none; }
    .radio-toggle input:checked + label {
      background: rgba(212, 175, 55, 0.2);
      border-color: #d4af37;
      color: #d4af37;
    }
  </style>
</head>
<body>
  <div class="royal-card">
    <i class="fa-solid fa-star rotating-star"></i>
    
    <div class="text-center mb-4">
      <div class="w-14 h-14 mx-auto bg-gradient-to-br from-[#d4af37] to-[#b8860b] rounded-full flex items-center justify-center mb-3 shadow-[0_0_25px_rgba(212,175,55,0.5)]">
        <i class="fa-solid fa-laptop-code text-2xl text-black"></i>
      </div>
      <h1 class="royal-title">استوديو Apex</h1>
      <p class="text-[10px] text-[#d4af37] font-bold tracking-widest">أنشئ موقعك الإلكتروني الآن</p>
    </div>
    
    <div class="bg-black/40 border border-[#d4af37]/20 rounded-lg p-2 mb-4 text-center">
      <p class="text-[10px] text-slate-400 mb-1">السعر الثابت</p>
      <p class="text-lg font-black text-[#d4af37]">150 <span class="text-xs">USD</span></p>
      <p class="text-[9px] text-green-400 font-bold mt-1">✨ تقسيط متاح - عرض محدود لأول 10 زبائن</p>
    </div>
    
    <form id="websiteForm" class="space-y-3">
      <div>
        <label class="block text-[10px] text-[#d4af37] font-bold mb-1">الاسم الكامل</label>
        <input type="text" name="name" required class="gold-input" placeholder="أدخل اسمك">
      </div>
      
      <div>
        <label class="block text-[10px] text-[#d4af37] font-bold mb-1">رقم الهاتف</label>
        <input type="tel" name="phone" required class="gold-input" placeholder="09xxxxxxxx" dir="ltr">
      </div>
      
      <div>
        <label class="block text-[10px] text-[#d4af37] font-bold mb-1">نوع الموقع</label>
        <select name="site_type" class="gold-input">
          <option value="متجر إلكتروني">متجر إلكتروني</option>
          <option value="موقع شركة">موقع شركة</option>
          <option value="مدونة">مدونة</option>
          <option value="تطبيق">تطبيق</option>
          <option value="أخرى">أخرى</option>
        </select>
      </div>
      
      <div>
        <label class="block text-[10px] text-[#d4af37] font-bold mb-1">وصف الموقع (ماذا تريد أن يفعل؟)</label>
        <textarea name="description" rows="2" class="gold-input" placeholder="مثال: متجر لبيع الملابس مع سلة شراء..."></textarea>
      </div>
      
      <div>
        <label class="block text-[10px] text-[#d4af37] font-bold mb-1">هل تريد التقسيط؟</label>
        <div class="radio-toggle">
          <input type="radio" name="wants_installment" value="1" id="inst-yes">
          <label for="inst-yes">✓ نعم</label>
          <input type="radio" name="wants_installment" value="0" id="inst-no" checked>
          <label for="inst-no">✗ لا</label>
        </div>
      </div>
      
      <button type="submit" id="submitBtn" class="gold-btn">
        <i class="fa-solid fa-paper-plane"></i> أرسل الطلب الآن
      </button>
    </form>
    
    <div class="text-center mt-3">
      <a href="/" class="text-[10px] text-slate-500 hover:text-[#d4af37] transition">
        <i class="fa-solid fa-arrow-right"></i> العودة للمتجر
      </a>
    </div>
  </div>
  
  <div id="successModal" class="fixed inset-0 bg-black/95 hidden items-center justify-center p-4 z-50">
    <div class="bg-[#0a0a0a] border-2 border-[#d4af37] rounded-2xl p-6 max-w-xs text-center">
      <div class="w-16 h-16 mx-auto bg-[#d4af37]/20 border-2 border-[#d4af37] rounded-full flex items-center justify-center mb-3">
        <i class="fa-solid fa-check text-3xl text-[#d4af37]"></i>
      </div>
      <h2 class="text-lg font-black text-[#d4af37] mb-2">تم استلام طلبك!</h2>
      <p class="text-xs text-slate-300 mb-4">سيتم التواصل معك قريباً على واتساب</p>
      <a href="/" class="inline-block bg-gradient-to-r from-[#d4af37] to-[#b8860b] text-black font-bold py-2 px-6 rounded-lg text-sm">
        العودة للمتجر
      </a>
    </div>
  </div>
  
  <script>
    function playClick() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.1);
      } catch(e) {}
    }
    
    document.querySelectorAll('button, input, select, textarea, a').forEach(el => {
      el.addEventListener('pointerdown', playClick);
    });
    
    document.getElementById('websiteForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الإرسال...';
      btn.disabled = true;
      
      const formData = new FormData(this);
      const data = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        site_type: formData.get('site_type'),
        description: formData.get('description'),
        wants_installment: formData.get('wants_installment') === '1'
      };
      
      try {
        const res = await fetch('/api/request-website', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        
        if (res.ok && result.success) {
          document.getElementById('successModal').classList.remove('hidden');
          document.getElementById('successModal').classList.add('flex');
          this.reset();
        } else {
          alert(result.message || 'حدث خطأ');
          btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> أرسل الطلب الآن';
          btn.disabled = false;
        }
      } catch(e) {
        alert('حدث خطأ في الاتصال');
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> أرسل الطلب الآن';
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
