<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>درع Apex | حصن الوساطة الآمنة</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { box-sizing: border-box; font-family: 'Tajawal', sans-serif; }
    body { 
      background-color: #030712; 
      background-image: radial-gradient(circle at 50% 0%, rgba(0, 243, 255, 0.15), transparent 60%), radial-gradient(circle at 85% 30%, rgba(255, 0, 229, 0.08), transparent 40%); 
      color: white; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 15px; margin: 0; 
    }
    .glass-card { 
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(20px); border: 1px solid rgba(0, 243, 255, 0.3); 
      box-shadow: 0 0 40px rgba(0, 243, 255, 0.1); border-radius: 20px; width: 100%; max-width: 550px; padding: 30px 25px; 
      animation: floatIn 0.6s ease-out forwards; position: relative; overflow: hidden;
    }
    @keyframes floatIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    
    /* شارات الأمان */
    .badge { background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px; padding: 6px 10px; font-size: 10px; font-weight: bold; color: #00f3ff; display: flex; align-items: center; gap: 5px; }
    
    /* الخط الزمني */
    .timeline { display: flex; justify-content: space-between; align-items: center; margin: 20px 0; position: relative; }
    .timeline::before { content: ''; position: absolute; top: 15px; left: 0; right: 0; height: 2px; background: rgba(0, 243, 255, 0.2); z-index: 1; }
    .step { display: flex; flex-direction: column; align-items: center; z-index: 2; width: 25%; }
    .step-circle { width: 30px; height: 30px; border-radius: 50%; background: #0f172a; border: 2px solid #00f3ff; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 12px; color: #00f3ff; margin-bottom: 5px; transition: all 0.3s; }
    .step.active .step-circle { background: #00f3ff; color: #000; box-shadow: 0 0 15px rgba(0, 243, 255, 0.6); }
    .step-text { font-size: 9px; font-weight: bold; color: #94a3b8; text-align: center; }
    .step.active .step-text { color: #00f3ff; }

    .section-title { background: rgba(0, 243, 255, 0.1); color: #00f3ff; padding: 8px 12px; border-radius: 8px; font-weight: 900; font-size: 13px; margin-bottom: 15px; border-right: 3px solid #00f3ff; display: flex; align-items: center; gap: 8px; }
    .input-group { position: relative; margin-bottom: 12px; }
    .input-group label { display: block; font-size: 11px; font-weight: 700; color: #8892b0; margin-bottom: 4px; }
    .input-group input { width: 100%; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 10px 12px; color: white; font-size: 13px; outline: none; transition: 0.3s; }
    .input-group input:focus { border-color: #00f3ff; box-shadow: 0 0 10px rgba(0, 243, 255, 0.2); }
    
    /* مربع رفع الملفات */
    .file-upload { border: 1px dashed rgba(0, 243, 255, 0.4); background: rgba(0, 243, 255, 0.05); padding: 12px 10px; border-radius: 10px; text-align: center; cursor: pointer; transition: 0.3s; display: block; height: 100%; }
    .file-upload:hover { background: rgba(0, 243, 255, 0.1); border-color: #00f3ff; }
    .file-upload input { display: none; }
    .file-upload span { font-size: 10px; color: #00f3ff; font-weight: bold; display: block; margin-top: 4px; transition: 0.3s; }
    .file-upload i { color: #64748b; transition: 0.3s; }
    
    /* حالة الرفع الناجح (اللون الأخضر) */
    .file-upload.uploaded { border-color: #39ff14 !important; background: rgba(57, 255, 20, 0.1) !important; box-shadow: 0 0 15px rgba(57, 255, 20, 0.2); }
    .file-upload.uploaded span { color: #39ff14 !important; }
    .file-upload.uploaded i { color: #39ff14 !important; }

    .submit-btn { width: 100%; background: linear-gradient(135deg, #00f3ff, #0055ff); color: white; font-weight: 900; font-size: 15px; padding: 15px; border-radius: 10px; border: none; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 15px rgba(0, 243, 255, 0.4); margin-top: 20px; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(0, 243, 255, 0.6); }
    
    /* النوافذ المنبثقة */
    #successModal, #shieldIntroModal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 9999; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(5px); }
    .modal-content { background: #0f172a; border: 2px solid #00f3ff; border-radius: 20px; padding: 30px 20px; text-align: center; max-width: 350px; width: 100%; box-shadow: 0 0 50px rgba(0, 243, 255, 0.3); }
  </style>
</head>
<body>
  <div class="glass-card">
    
    <!-- الدرع النابض -->
    <div class="text-center mb-4">
      <div class="w-20 h-20 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 shadow-[0_0_30px_rgba(0,243,255,0.6)] animate-pulse">
        <i class="fa-solid fa-shield-halved text-4xl text-white"></i>
      </div>
      <h1 class="text-2xl font-black text-white" style="text-shadow: 0 0 10px rgba(0,243,255,0.5);">درع Apex للوساطة</h1>
      <p class="text-slate-400 text-xs mt-1">نظام حماية سيبراني يضمن حقوق الطرفين بنسبة 100%</p>
    </div>

    <!-- شارات الأمان -->
    <div class="flex justify-center gap-2 mb-6 flex-wrap">
      <div class="badge"><i class="fa-solid fa-lock"></i> تشفير 256-bit</div>
      <div class="badge"><i class="fa-solid fa-scale-balanced"></i> وسيط محايد</div>
      <div class="badge"><i class="fa-solid fa-user-shield"></i> حماية الهويات</div>
    </div>

    <!-- الخط الزمني -->
    <div class="timeline">
      <div class="step active">
        <div class="step-circle">1</div>
        <div class="step-text">بيانات الأطراف</div>
      </div>
      <div class="step">
        <div class="step-circle">2</div>
        <div class="step-text">رفع الهويات</div>
      </div>
      <div class="step">
        <div class="step-circle">3</div>
        <div class="step-text">تأمين المبلغ</div>
      </div>
      <div class="step">
        <div class="step-circle">4</div>
        <div class="step-text">تحرير الأموال</div>
      </div>
    </div>

    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24; padding: 10px; border-radius: 10px; margin-bottom: 20px; font-size: 11px; text-align: center; line-height: 1.6;">
      ⚠️ <b>رسوم الوساطة:</b> 1.5$ من المشتري + 1.5$ من البائع.<br>
      مطلوب رفع الهوية ورقم عملية التحويل لإصدار الشهادة.
    </div>

    <form id="shieldForm" enctype="multipart/form-data">
      <!-- الحقل المخفي (Honeypot) -->
      <input type="text" name="website_url" style="display:none !important" tabindex="-1" autocomplete="off">
      
      <!-- المشتري -->
      <div class="section-title"><i class="fa-solid fa-user-tag"></i> بيانات المشتري (يدفع 1.5$ رسوم + سعر الهاتف)</div>
      <div class="input-group">
        <label>رقم هاتف المشتري *</label>
        <input type="tel" name="buyer_phone" required placeholder="09xxxxxxxx" dir="ltr" class="text-right">
      </div>
      <div class="input-group">
        <label>رقم عملية تحويل رسوم المشتري (1.5$) *</label>
        <input type="text" name="buyer_txid" required placeholder="TXID أو رقم العملية">
      </div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <label class="file-upload" data-default-text="هوية المشتري (أمامي) *">
          <input type="file" name="buyer_id_front" accept="image/*" required onchange="handleFileUpload(this)">
          <i class="fa-solid fa-id-card text-xl mb-1"></i>
          <span>هوية المشتري (أمامي) *</span>
        </label>
        <label class="file-upload" data-default-text="هوية المشتري (خلفي) *">
          <input type="file" name="buyer_id_back" accept="image/*" required onchange="handleFileUpload(this)">
          <i class="fa-solid fa-id-card text-xl mb-1"></i>
          <span>هوية المشتري (خلفي) *</span>
        </label>
      </div>

      <!-- البائع -->
      <div class="section-title mt-4"><i class="fa-solid fa-store"></i> بيانات البائع (يدفع 1.5$ رسوم فقط)</div>
      <div class="input-group">
        <label>رقم هاتف البائع *</label>
        <input type="tel" name="seller_phone" required placeholder="09xxxxxxxx" dir="ltr" class="text-right">
      </div>
      <div class="input-group">
        <label>رقم عملية تحويل رسوم البائع (1.5$) *</label>
        <input type="text" name="seller_txid" required placeholder="TXID أو رقم العملية">
      </div>
      <div class="grid grid-cols-2 gap-2 mb-3">
        <label class="file-upload" data-default-text="هوية البائع (أمامي) *">
          <input type="file" name="seller_id_front" accept="image/*" required onchange="handleFileUpload(this)">
          <i class="fa-solid fa-id-card text-xl mb-1"></i>
          <span>هوية البائع (أمامي) *</span>
        </label>
        <label class="file-upload" data-default-text="هوية البائع (خلفي) *">
          <input type="file" name="seller_id_back" accept="image/*" required onchange="handleFileUpload(this)">
          <i class="fa-solid fa-id-card text-xl mb-1"></i>
          <span>هوية البائع (خلفي) *</span>
        </label>
      </div>

      <!-- المبلغ -->
      <div class="section-title mt-4"><i class="fa-solid fa-money-bill-wave"></i> تفاصيل الصفقة</div>
      <div class="input-group">
        <label>سعر الهاتف المتفق عليه (الذي سيحوله المشتري لـ Apex) *</label>
        <input type="text" name="amount" required placeholder="مثال: 500$">
      </div>

      <button type="submit" class="submit-btn">
        <i class="fa-solid fa-paper-plane"></i> إرسال طلب الوساطة
      </button>
    </form>

    <div class="text-center mt-6 flex justify-between px-2">
      <a href="/shield/track" class="text-xs text-cyan-400 hover:underline"><i class="fa-solid fa-magnifying-glass"></i> تتبع حالة الطلب</a>
      <a href="/" class="text-xs text-slate-500 hover:text-cyan-400 transition-colors"><i class="fa-solid fa-arrow-right ml-1"></i> العودة للمتجر</a>
    </div>
  </div>

  <!-- نافذة النجاح -->
  <div id="successModal">
    <div class="modal-content">
      <div class="w-20 h-20 bg-cyan-500/10 border-2 border-cyan-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-[0_0_20px_rgba(0,243,255,0.5)]">
        <i class="fa-solid fa-check text-4xl text-cyan-500"></i>
      </div>
      <h2 class="text-xl font-black text-white mb-2">تم استلام طلب الوساطة!</h2>
      <p class="text-slate-400 text-sm mb-6 leading-relaxed">
        يرجى التواصل معنا عبر الواتساب لإرسال أرقام العمليات والتأكد من وصول المبلغ.<br>سيتم إصدار الشهادة فور مراجعة البيانات.
      </p>
      <a href="https://wa.me/963980259127?text=مرحباً،%20أنا%20طلبت%20وساطة%20Apex%20وأريد%20إرسال%20أرقام%20العمليات" target="_blank" class="w-full bg-[#25D366] text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 shadow-lg mb-3">
        <i class="fa-brands fa-whatsapp text-xl"></i> تواصل لإتمام التحقق
      </a>
      <a href="/" class="block w-full bg-slate-800 text-slate-300 font-bold py-3 rounded-xl text-sm">العودة للمتجر</a>
    </div>
  </div>

  <!-- النافذة التوعوية -->
  <div id="shieldIntroModal" class="fixed inset-0 bg-black/90 z-[99999] hidden items-center justify-center p-4 backdrop-blur-md" style="opacity: 0; transition: opacity 0.3s ease;">
    <div class="bg-[#0f172a] border border-cyan-500/40 w-full max-w-md rounded-3xl p-6 shadow-[0_0_50px_rgba(0,243,255,0.2)] relative text-center transform scale-95 transition-transform duration-300" id="shieldIntroBox">
      <div class="w-20 h-20 bg-cyan-500/10 border-2 border-cyan-400 rounded-full flex items-center justify-center mx-auto mb-5 shadow-[0_0_30px_rgba(0,243,255,0.4)]">
        <i class="fa-solid fa-shield-halved text-4xl text-cyan-400"></i>
      </div>
      <h2 class="text-2xl font-black text-white mb-3">درع Apex للوساطة الآمنة</h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        <span class="text-cyan-400 font-bold">نظامنا هو الحل الأول في سوريا لمنع عمليات النصب.</span><br><br>
        ✅ <b>للمشتري:</b> أموالك محجوزة لدى Apex حتى تستلم وتفحص.<br>
        ✅ <b>للبائع:</b> نضمن وجود المال قبل إرسال الجهاز.<br>
        ✅ <b>للجميع:</b> نتحقق من الهويات ونحذفها فوراً بعد الصفقة.
      </p>
      <button onclick="closeShieldIntro()" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black py-3 rounded-xl shadow-[0_4px_15px_rgba(0,243,255,0.4)] hover:scale-[1.02] transition-transform text-lg">
        <i class="fa-solid fa-check-circle"></i> موافق، تابع الطلب
      </button>
    </div>
  </div>

  <script>
    // دالة تغيير لون الرفع إلى الأخضر
    function handleFileUpload(input) {
      const label = input.closest('.file-upload');
      const icon = label.querySelector('i');
      const span = label.querySelector('span');
      
      if (input.files && input.files.length > 0) {
        label.classList.add('uploaded');
        icon.className = 'fa-solid fa-check-circle text-xl mb-1';
        span.innerText = 'تم الرفع بنجاح';
      } else {
        label.classList.remove('uploaded');
        icon.className = 'fa-solid fa-id-card text-xl mb-1';
        span.innerText = label.getAttribute('data-default-text');
      }
    }

    // إرسال النموذج
    document.getElementById('shieldForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = this.querySelector('button[type="submit"]');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الرفع...';

      const formData = new FormData(this);

      try {
        const res = await fetch('/api/shield/request', { method: 'POST', body: formData });
        if (res.ok) {
          document.getElementById('successModal').style.display = 'flex';
          this.reset();
          document.querySelectorAll('.file-upload').forEach(label => {
            label.classList.remove('uploaded');
            label.querySelector('i').className = 'fa-solid fa-id-card text-xl mb-1';
            label.querySelector('span').innerText = label.getAttribute('data-default-text');
          });
          btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> إرسال طلب الوساطة';
        } else {
          alert('حدث خطأ، حاول لاحقاً');
          btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> إرسال طلب الوساطة';
        }
      } catch(e) {
        alert('حدث خطأ في الاتصال');
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> إرسال طلب الوساطة';
      }
    });

    // إغلاق النافذة التوعوية
    function closeShieldIntro() {
      const modal = document.getElementById('shieldIntroModal');
      const box = document.getElementById('shieldIntroBox');
      box.classList.replace('scale-100', 'scale-95');
      modal.style.opacity = '0';
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        sessionStorage.setItem('shield_intro_seen', 'true');
      }, 300);
    }

    // إظهار النافذة عند أول زيارة
    document.addEventListener('DOMContentLoaded', function() {
      if (!sessionStorage.getItem('shield_intro_seen')) {
        setTimeout(() => {
          const modal = document.getElementById('shieldIntroModal');
          const box = document.getElementById('shieldIntroBox');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => {
            modal.style.opacity = '1';
            box.classList.replace('scale-95', 'scale-100');
          }, 50);
        }, 500);
      }
    });
  </script>
</body>
</html>
