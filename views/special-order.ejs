      background-repeat: no-repeat; background-position: left 12px center; background-size: 14px;
    }
    .delivery-badge { display: none; margin-bottom: 15px; padding: 10px; border-radius: 10px; font-size: 12px; font-weight: 700; text-align: center; animation: popIn 0.3s ease; }
    @keyframes popIn { 0% { transform: scale(0.95); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
    
    /* تصميم النافذة المنبثقة الملكية */
    #successModal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .modal-content { background: #0f172a; border: 1px solid rgba(0,243,255,0.3); border-radius: 20px; padding: 30px 20px; text-align: center; max-width: 350px; width: 100%; box-shadow: 0 0 50px rgba(0,243,255,0.2); transform: scale(0.9); animation: scaleUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    @keyframes scaleUp { to { transform: scale(1); } }
  </style>
