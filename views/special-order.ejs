      border-radius: 20px; width: 100%; max-width: 380px; padding: 25px 20px; position: relative; overflow: hidden;
      animation: floatIn 0.6s ease-out forwards;
    }
    @keyframes floatIn { from { opacity: 0; transform: translateY(20px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .input-group { position: relative; margin-bottom: 15px; }
    .input-group i { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #8892b0; font-size: 14px; transition: 0.3s; }
    .input-group input, .input-group select {
      width: 100%; background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px;
      padding: 12px 35px 12px 12px; color: white; font-size: 13px; outline: none; transition: all 0.3s ease;
    }
    .input-group input:focus, .input-group select:focus { border-color: #00f3ff; box-shadow: 0 0 10px rgba(0, 243, 255, 0.15); background: rgba(0, 0, 0, 0.7); }
    .input-group input:focus + i { color: #00f3ff; }
    .submit-btn {
      width: 100%; background: linear-gradient(135deg, #00f3ff, #0055ff); color: white; font-weight: 700; font-size: 14px;
      padding: 14px; border-radius: 10px; border: none; cursor: pointer; transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(0, 243, 255, 0.2); margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px;
