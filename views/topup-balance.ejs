<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>شحن رصيد المحفظة | Apex Gaming</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Cairo', 'sans-serif'] } } } }</script>
  <style> body { background-color: #050505; color: white; background-image: radial-gradient(circle at 50% 0%, rgba(0,243,255,0.1), transparent 50%); } </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">
  <!-- تصغير النافبار -->
  <nav class="bg-black/50 backdrop-blur-md border-b border-cyan-500/20 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-3 h-10 flex justify-between items-center">
      <a href="/games/list?type=games" class="flex items-center gap-1.5 text-xs font-bold text-cyan-300 hover:text-white transition"><i class="fa-solid fa-arrow-right"></i> العودة للألعاب</a>
      <span class="text-xs font-black text-white"><i class="fa-solid fa-wallet text-cyan-400"></i> المحفظة</span>
    </div>
  </nav>

  <div class="max-w-lg mx-auto px-3 py-4 flex-1 w-full">
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-green-500/20 border border-green-500 text-green-400 p-2 rounded-lg mb-3 font-bold text-center text-[11px]">✅ تم إرسال طلب الإيداع بنجاح. سيتم مراجعته من قبل الإدارة وإضافة الرصيد قريباً.</div>
    <% } %>

    <!-- استعلام سريع -->
    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 shadow-xl mb-3">
      <h2 class="text-sm font-black text-white mb-2"><i class="fa-solid fa-search text-cyan-400"></i> 1. استعلام سريع عن الرصيد (اختياري)</h2>
      <form method="GET" action="/topup-balance" class="flex gap-2">
        <input type="tel" name="phone" value="<%= phoneQuery %>" required placeholder="أدخل رقم هاتفك" class="flex-1 bg-black border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:border-cyan-400 outline-none" dir="ltr">
        <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold px-4 rounded-lg transition text-xs">بحث</button>
      </form>
      <% if (phoneQuery) { %>
        <div class="mt-2 text-center">
          <p class="text-[10px] text-slate-400">رصيدك الحالي هو:</p>
          <p class="text-lg font-black text-green-400">$<%= userBalance.toFixed(2) %></p>
        </div>
      <% } %>
    </div>

    <!-- طلب إيداع جديد -->
    <form action="/topup-balance" method="POST" enctype="multipart/form-data" class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 shadow-xl">
      <h2 class="text-sm font-black text-white mb-3"><i class="fa-solid fa-plus-circle text-cyan-400"></i> 2. طلب إيداع رصيد جديد</h2>

      <div class="bg-cyan-500/10 border border-cyan-500/30 rounded-lg p-2 mb-3 text-[10px]">
        <p class="font-bold text-cyan-300 mb-1"><i class="fa-solid fa-info-circle"></i> تعليمات التحويل:</p>
        <ul class="list-disc list-inside text-slate-300 space-y-0.5">
          <li>يتم التحويل عبر <strong>سيريتل كاش</strong> إلى الرقم: <strong class="text-white" dir="ltr">0980259127</strong></li>
          <li>سعر الصرف: <strong>1 دولار = 170 ليرة سورية جديدة</strong></li>
          <li>بعد التحويل، أدخل تفاصيل العملية أدناه.</li>
        </ul>
      </div>

      <div class="mb-2">
        <label class="block text-[11px] font-bold text-slate-300 mb-1">رقم المحفظة (نفس رقم هاتفك)</label>
        <input type="tel" name="phone" value="<%= phoneQuery %>" required class="w-full bg-black border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:border-cyan-400 outline-none" placeholder="09xxxxxxxx" dir="ltr">
      </div>

      <div class="mb-2">
        <label class="block text-[11px] font-bold text-slate-300 mb-1">المبلغ بالدولار ($)</label>
        <input type="number" name="amount_usd" id="amountUsd" required min="1" step="1" class="w-full bg-black border border-slate-700 rounded-lg px-2 py-1.5 text-sm text-white focus:border-cyan-400 outline-none font-bold" placeholder="مثال: 5" dir="ltr" oninput="calcSyp()">
        <p class="text-[10px] text-cyan-300 mt-1 font-bold" id="sypEquivalent">الرجاء إدخال المبلغ...</p>
      </div>

      <div class="mb-2">
        <label class="block text-[11px] font-bold text-slate-300 mb-1">رقم عملية التحويل (اختياري)</label>
        <input type="text" name="transfer_ref" class="w-full bg-black border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:border-cyan-400 outline-none" placeholder="Transaction ID" dir="ltr">
      </div>

      <div class="mb-3">
        <label class="block text-[11px] font-bold text-slate-300 mb-1">صورة إشعار التحويل (اختياري)</label>
        <input type="file" name="receipt" accept="image/*" class="w-full bg-black border border-slate-700 rounded-lg px-2 py-1.5 text-[10px] text-white focus:border-cyan-400 outline-none">
      </div>

      <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black py-2 rounded-lg hover:shadow-[0_0_20px_rgba(0,243,255,0.4)] transition text-xs">إرسال طلب الإيداع</button>
    </form>
  </div>

  <script>
    function calcSyp() {
      const usd = parseFloat(document.getElementById('amountUsd').value) || 0;
      const newSyp = usd * 170;
      const oldSyp = newSyp * 100;
      const el = document.getElementById('sypEquivalent');
      if (usd > 0) {
        el.innerHTML = `يجب تحويل: <span class="text-green-400 font-black">${newSyp.toLocaleString()} ل.س جديدة</span> أو <span class="text-slate-400">${oldSyp.toLocaleString()} ل.س قديمة</span>`;
      } else {
        el.innerHTML = 'الرجاء إدخال المبلغ...';
      }
    }
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const savedPhone = localStorage.getItem('apex_user_phone');
      const phoneInput = document.querySelector('input[name="phone"][type="tel"]');
      if (savedPhone && phoneInput && !phoneInput.value) {
        phoneInput.value = savedPhone;
        const searchForm = document.querySelector('form[method="GET"]');
        if (searchForm) {
          const url = new URL(window.location);
          url.searchParams.set('phone', savedPhone);
          window.location.href = url.toString();
        }
      }
    });
  </script>
</body>
</html>
